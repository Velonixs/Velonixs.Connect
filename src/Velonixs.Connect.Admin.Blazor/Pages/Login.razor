@page "/login"
@using System.ComponentModel.DataAnnotations
@inject IVelonixsConnectApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Admin Login</PageTitle>

<section class="auth-shell">
    <div class="card shadow-sm auth-panel p-4">
        <p class="eyebrow">Admin access</p>
        <h1>Sign in to Velonixs Connect</h1>

        <ApiErrorAlert Error="error" Title="Sign in failed" />

        <EditForm Model="form" OnValidSubmit="LoginAsync" class="form-stack">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div>
                <label class="form-label">Email</label>
                <InputText class="form-control" @bind-Value="form.Email" type="email" autocomplete="username" />
            </div>

            <div>
                <label class="form-label">Password</label>
                <InputText class="form-control" @bind-Value="form.Password" type="password" autocomplete="current-password" />
            </div>

            <button class="btn btn-success w-100" type="submit" disabled="@isSubmitting">
                @(isSubmitting ? "Signing in" : "Sign in")
            </button>
        </EditForm>
    </div>
</section>

@code {
    private readonly LoginForm form = new();
    private bool isSubmitting;
    private ApiClientException? error;

    private async Task LoginAsync()
    {
        isSubmitting = true;
        error = null;

        try
        {
            await ApiClient.LoginAsync(new LoginRequest(form.Email, form.Password));
            Navigation.NavigateTo("/");
        }
        catch (ApiClientException exception)
        {
            error = exception;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private sealed class LoginForm
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = string.Empty;

        [Required]
        public string Password { get; set; } = string.Empty;
    }
}
