@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject IPlatformAdministrationService PlatformAdministrationService

<div class="admin-application @(_sidebarCollapsed ? "sidebar-collapsed" : null) @(_mobileNavOpen ? "mobile-nav-open" : null)">
    <aside class="app-sidebar" id="admin-sidebar" aria-label="Primary navigation">
        <div class="sidebar-brand-row">
            <a class="sidebar-brand" href="/admin/dashboard" aria-label="Velonixs Connect Admin dashboard">
                <img class="vx-shell-logo" src="/images/velonixs-logo.jpg" alt="Velonixs" />
                <span class="brand-copy"><strong>Velonixs Connect</strong><small>Platform Admin</small></span>
            </a>
            <button class="icon-button sidebar-collapse-button" type="button" @onclick="ToggleSidebar" aria-label="@(_sidebarCollapsed ? "Expand sidebar" : "Collapse sidebar")" aria-expanded="@(!_sidebarCollapsed)">
                <svg class="ui-icon" aria-hidden="true"><use href="/icons/ui-icons.svg#icon-panel"></use></svg>
            </button>
            <button class="icon-button mobile-close-button" type="button" @onclick="CloseMobileNav" aria-label="Close navigation">
                <svg class="ui-icon" aria-hidden="true"><use href="/icons/ui-icons.svg#icon-close"></use></svg>
            </button>
        </div>

        <div class="sidebar-scroll">
            <nav class="sidebar-nav">
                <div class="nav-section">
                    <span class="nav-section-label">Overview</span>
                    <NavLink class="nav-entry" href="/admin/dashboard" Match="NavLinkMatch.All">
                        <svg class="ui-icon" aria-hidden="true"><use href="/icons/ui-icons.svg#icon-grid"></use></svg>
                        <span>Dashboard</span>
                    </NavLink>
                    @NavItem("Orders", "receipt", BusinessHref("orders"), "Select a business to open orders")
                    @NavItem("Customers", "users", BusinessHref("customers"), "Select a business to open customers")
                    @NavItem("Catalog", "box", BusinessHref("products"), "Select a business to manage its catalog")
                </div>

                <div class="nav-section">
                    <span class="nav-section-label">Businesses</span>
                    @NavItem("Businesses", "building", BusinessHref("businesses"), "Select a business to manage it")
                    @NavItem("Customers", "users", BusinessHref("customers"), "Select a business to open customers")
                </div>

                <div class="nav-section">
                    <span class="nav-section-label">Integrations</span>
                    @NavItem("WhatsApp", "whatsapp", BusinessHref("sync"), "Select a business to configure WhatsApp")
                    @NavItem("Meta Catalog", "box", BusinessHref("sync"), "Select a business to manage Meta Catalog")
                </div>

                <div class="nav-section">
                    <span class="nav-section-label">Settings</span>
                    @NavItem("Integrations", "plug", BusinessHref("sync"), "Select a business to manage integrations")
                    @NavItem("Users & Roles", "shield", BusinessHref("businesses"), "Select a business to manage users")
                </div>
            </nav>
        </div>

        <div class="sidebar-footer">
            @NavItem("Settings", "settings", BusinessHref("businesses"), "Select a business to open settings")
            <AuthorizeView>
                <Authorized Context="authContext">
                    <button class="sidebar-profile" type="button" @onclick="ToggleSidebarProfileMenu" aria-expanded="@_sidebarProfileOpen">
                        <span class="avatar" aria-hidden="true">@Initials(authContext.User.Identity?.Name)</span>
                        <span class="profile-copy"><strong>@DisplayName(authContext.User.Identity?.Name)</strong><small>Platform administrator</small></span>
                        <svg class="ui-icon profile-chevron" aria-hidden="true"><use href="/icons/ui-icons.svg#icon-chevron-up"></use></svg>
                    </button>
                    @if (_sidebarProfileOpen)
                    {
                        <div class="sidebar-profile-menu">
                            <a href="@(BusinessHref("businesses") ?? "/admin/dashboard")"><svg class="ui-icon" aria-hidden="true"><use href="/icons/ui-icons.svg#icon-settings"></use></svg>Account settings</a>
                            <form method="post" action="/admin/logout">
                                <AntiforgeryToken />
                                <button type="submit"><svg class="ui-icon" aria-hidden="true"><use href="/icons/ui-icons.svg#icon-log-out"></use></svg>Sign out</button>
                            </form>
                        </div>
                    }
                </Authorized>
            </AuthorizeView>
        </div>
    </aside>

    @if (_mobileNavOpen)
    {
        <button class="sidebar-backdrop" type="button" @onclick="CloseMobileNav" aria-label="Close navigation"></button>
    }

    <div class="app-workspace">
        <header class="app-topbar">
            <div class="topbar-title-group">
                <button class="icon-button mobile-menu-button" type="button" @onclick="OpenMobileNav" aria-controls="admin-sidebar" aria-expanded="@_mobileNavOpen" aria-label="Open navigation">
                    <svg class="ui-icon" aria-hidden="true"><use href="/icons/ui-icons.svg#icon-menu"></use></svg>
                </button>
                <div>
                    <p class="topbar-eyebrow">@PageSection</p>
                    <strong class="topbar-title">@PageTitle</strong>
                </div>
            </div>

            <div class="global-search">
                <svg class="ui-icon" aria-hidden="true"><use href="/icons/ui-icons.svg#icon-search"></use></svg>
                <input type="search" placeholder="Search pages and tools" aria-label="Search pages and tools" @bind="_searchTerm" @bind:event="oninput" @onfocus="ShowSearch" @onkeydown="HandleSearchKey" />
                <kbd aria-hidden="true">/</kbd>
                @if (_searchOpen && !string.IsNullOrWhiteSpace(_searchTerm))
                {
                    <div class="search-results" role="listbox" aria-label="Search results">
                        @foreach (var result in FilteredSearchItems)
                        {
                            <a href="@result.Href" role="option">
                                <svg class="ui-icon" aria-hidden="true"><use href="/icons/ui-icons.svg#icon-@result.Icon"></use></svg>
                                <span><strong>@result.Label</strong><small>@result.Section</small></span>
                                <svg class="ui-icon search-arrow" aria-hidden="true"><use href="/icons/ui-icons.svg#icon-arrow-up-right"></use></svg>
                            </a>
                        }
                        @if (!FilteredSearchItems.Any())
                        {
                            <p class="search-empty">No matching page is available.</p>
                        }
                    </div>
                }
            </div>

            <div class="topbar-actions">
                <label class="business-switcher">
                    <svg class="ui-icon" aria-hidden="true"><use href="/icons/ui-icons.svg#icon-building"></use></svg>
                    <span class="visually-hidden">Current business</span>
                    <select value="@(_activeBusinessId?.ToString() ?? string.Empty)" @onchange="ChangeBusiness" aria-label="Current business">
                        <option value="">All businesses</option>
                        @foreach (var business in _businesses)
                        {
                            <option value="@business.BusinessId">@business.Name</option>
                        }
                    </select>
                    <svg class="ui-icon switcher-chevron" aria-hidden="true"><use href="/icons/ui-icons.svg#icon-chevron-down"></use></svg>
                </label>

                <a class="topbar-primary-action" href="/admin/dashboard#business-onboarding">
                    <svg class="ui-icon" aria-hidden="true"><use href="/icons/ui-icons.svg#icon-plus"></use></svg>
                    <span>Add business</span>
                </a>

                <div class="topbar-menu-wrap">
                    <button class="icon-button notification-button" type="button" @onclick="ToggleNotifications" aria-label="Notifications" aria-expanded="@_notificationsOpen">
                        <svg class="ui-icon" aria-hidden="true"><use href="/icons/ui-icons.svg#icon-bell"></use></svg>
                    </button>
                    @if (_notificationsOpen)
                    {
                        <div class="topbar-popover notifications-popover">
                            <div class="popover-heading"><strong>Notifications</strong><span>0 new</span></div>
                            <div class="empty-notifications">
                                <span class="empty-icon"><svg class="ui-icon" aria-hidden="true"><use href="/icons/ui-icons.svg#icon-check"></use></svg></span>
                                <strong>You're all caught up</strong>
                                <small>New operational alerts will appear here.</small>
                            </div>
                        </div>
                    }
                </div>

                <AuthorizeView>
                    <Authorized Context="authContext">
                        <div class="topbar-menu-wrap profile-menu-wrap">
                            <button class="topbar-avatar-button" type="button" @onclick="ToggleProfileMenu" aria-label="Open profile menu" aria-expanded="@_profileMenuOpen">
                                <span class="avatar" aria-hidden="true">@Initials(authContext.User.Identity?.Name)</span>
                                <svg class="ui-icon" aria-hidden="true"><use href="/icons/ui-icons.svg#icon-chevron-down"></use></svg>
                            </button>
                            @if (_profileMenuOpen)
                            {
                                <div class="topbar-popover profile-popover">
                                    <div class="profile-popover-user">
                                        <span class="avatar">@Initials(authContext.User.Identity?.Name)</span>
                                        <span><strong>@DisplayName(authContext.User.Identity?.Name)</strong><small>@authContext.User.Identity?.Name</small></span>
                                    </div>
                                    <a href="@(BusinessHref("businesses") ?? "/admin/dashboard")"><svg class="ui-icon" aria-hidden="true"><use href="/icons/ui-icons.svg#icon-settings"></use></svg>Account settings</a>
                                    <form method="post" action="/admin/logout">
                                        <AntiforgeryToken />
                                        <button type="submit"><svg class="ui-icon" aria-hidden="true"><use href="/icons/ui-icons.svg#icon-log-out"></use></svg>Sign out</button>
                                    </form>
                                </div>
                            }
                        </div>
                    </Authorized>
                </AuthorizeView>
            </div>
        </header>

        <main class="blazor-main" id="main-content">
            @Body
        </main>
        <footer class="vx-app-footer">© 2026 Velonixs Systems Private Limited. All rights reserved.</footer>
    </div>
</div>

@code {
    private bool _sidebarCollapsed;
    private bool _mobileNavOpen;
    private bool _notificationsOpen;
    private bool _profileMenuOpen;
    private bool _sidebarProfileOpen;
    private bool _searchOpen;
    private string _searchTerm = string.Empty;
    private Guid? _activeBusinessId;
    private IReadOnlyCollection<PlatformBusinessSummary> _businesses = Array.Empty<PlatformBusinessSummary>();

    private string CurrentPath => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
    private string PageTitle => CurrentPath switch
    {
        "admin/dashboard" => "Dashboard",
        "admin/master-catalog" => "Master catalog",
        var path when path.StartsWith("admin/orders/", StringComparison.OrdinalIgnoreCase) => "Orders",
        var path when path.StartsWith("admin/customers/", StringComparison.OrdinalIgnoreCase) => "Customers",
        var path when path.StartsWith("admin/catalog/", StringComparison.OrdinalIgnoreCase) => "Catalog",
        var path when path.StartsWith("admin/integrations/", StringComparison.OrdinalIgnoreCase) => "WhatsApp integration",
        var path when path.StartsWith("admin/businesses/", StringComparison.OrdinalIgnoreCase) => "Business settings",
        _ => "Velonixs Connect"
    };

    private string PageSection => CurrentPath switch
    {
        "admin/dashboard" => "Overview",
        "admin/master-catalog" => "Catalog",
        var path when path.StartsWith("admin/integrations/", StringComparison.OrdinalIgnoreCase) => "Integrations",
        var path when path.StartsWith("admin/businesses/", StringComparison.OrdinalIgnoreCase) => "Settings",
        _ => "Workspace"
    };

    private IEnumerable<ShellSearchItem> FilteredSearchItems => SearchItems
        .Where(item => item.Label.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) || item.Section.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase))
        .Take(7);

    private IEnumerable<ShellSearchItem> SearchItems
    {
        get
        {
            yield return new("Dashboard", "Overview", "grid", "/admin/dashboard");
            yield return new("Master catalog", "Catalog", "box", "/admin/master-catalog");
            if (_activeBusinessId is not null)
            {
                yield return new("Orders", "Workspace", "receipt", BusinessHref("orders")!);
                yield return new("Customers", "Workspace", "users", BusinessHref("customers")!);
                yield return new("Products & categories", "Catalog", "box", BusinessHref("products")!);
                yield return new("Business profile", "Settings", "store", BusinessHref("businesses")!);
                yield return new("WhatsApp integration", "Automation", "whatsapp", BusinessHref("sync")!);
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        ReadBusinessFromUri();

        try
        {
            var dashboard = await PlatformAdministrationService.GetDashboardAsync();
            _businesses = dashboard.Businesses;
        }
        catch
        {
            _businesses = Array.Empty<PlatformBusinessSummary>();
        }
    }

    private RenderFragment NavItem(string label, string icon, string? href, string disabledHint) => builder =>
    {
        if (href is null)
        {
            return;
        }
        else
        {
            builder.OpenElement(0, "a");
            builder.AddAttribute(1, "class", $"nav-entry {(IsCurrent(href) ? "active" : null)}");
            builder.AddAttribute(2, "href", href);
        }
        builder.AddMarkupContent(4, $"<svg class=\"ui-icon\" aria-hidden=\"true\"><use href=\"/icons/ui-icons.svg#icon-{icon}\"></use></svg><span>{label}</span>");
        builder.CloseElement();
    };

    private string? BusinessHref(string section) => _activeBusinessId is Guid id
        ? $"/admin/{(section == "products" ? "catalog" : section == "sync" ? "integrations" : section)}/{id}"
        : null;

    private bool IsCurrent(string href) => Navigation.Uri.StartsWith(Navigation.ToAbsoluteUri(href).ToString(), StringComparison.OrdinalIgnoreCase);

    private void ToggleSidebar() => _sidebarCollapsed = !_sidebarCollapsed;
    private void OpenMobileNav() => _mobileNavOpen = true;
    private void CloseMobileNav() => _mobileNavOpen = false;

    private void ToggleNotifications()
    {
        _notificationsOpen = !_notificationsOpen;
        _profileMenuOpen = false;
        _sidebarProfileOpen = false;
        _searchOpen = false;
    }

    private void ToggleProfileMenu()
    {
        _profileMenuOpen = !_profileMenuOpen;
        _sidebarProfileOpen = false;
        _notificationsOpen = false;
        _searchOpen = false;
    }

    private void ToggleSidebarProfileMenu()
    {
        _sidebarProfileOpen = !_sidebarProfileOpen;
        _profileMenuOpen = false;
        _notificationsOpen = false;
        _searchOpen = false;
    }

    private void ShowSearch(FocusEventArgs _) => _searchOpen = true;

    private void HandleSearchKey(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            _searchOpen = false;
            _searchTerm = string.Empty;
        }
    }

    private void ChangeBusiness(ChangeEventArgs args)
    {
        if (!Guid.TryParse(args.Value?.ToString(), out var businessId))
        {
            _activeBusinessId = null;
            Navigation.NavigateTo("/admin/dashboard");
            return;
        }

        _activeBusinessId = businessId;
        var section = CurrentPath.Split('/').Skip(1).FirstOrDefault();
        section = section is "orders" or "customers" or "catalog" or "integrations" or "businesses" ? section : "businesses";
        Navigation.NavigateTo($"/admin/{section}/{businessId}");
    }

    private void ReadBusinessFromUri()
    {
        var id = CurrentPath.Split('/').Select(segment => Guid.TryParse(segment, out var value) ? value : Guid.Empty).FirstOrDefault(value => value != Guid.Empty);
        _activeBusinessId = id == Guid.Empty ? null : id;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _mobileNavOpen = false;
        _searchOpen = false;
        _notificationsOpen = false;
        _profileMenuOpen = false;
        _sidebarProfileOpen = false;
        ReadBusinessFromUri();
        _ = InvokeAsync(StateHasChanged);
    }

    private static string DisplayName(string? identityName) => string.IsNullOrWhiteSpace(identityName) ? "Admin" : identityName.Split('@')[0];

    private static string Initials(string? identityName)
    {
        var display = DisplayName(identityName);
        var parts = display.Split(new[] { '.', '_', '-', ' ' }, StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Take(2).Select(part => char.ToUpperInvariant(part[0])));
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private sealed record ShellSearchItem(string Label, string Section, string Icon, string Href);
}
