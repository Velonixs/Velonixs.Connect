@inherits LayoutComponentBase

<div class="blazor-shell">
    <aside class="blazor-sidebar">
        <a class="blazor-brand" href="/admin/blazor">
            <img class="blazor-brand-logo" src="/images/velonixs-logo.jpg" alt="Velonixs Systems Private Limited logo" />
            <span><strong>Velonixs</strong><small>Admin Portal</small></span>
        </a>
        <nav>
            <a href="/admin/blazor">Dashboard</a>
            <a href="/admin/blazor/master-catalog">Master Catalog</a>
            <form method="post" action="/admin/logout">
                <AntiforgeryToken />
                <button type="submit">Sign out</button>
            </form>
        </nav>
    </aside>
    <main class="blazor-main">
        @Body
    </main>
</div>
