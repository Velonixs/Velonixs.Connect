@page "/admin/integrations/{BusinessId:guid}"
@attribute [Authorize(Roles = AppRoles.PlatformAdmin)]
@inject IRestaurantService RestaurantService
@inject IMetaCatalogSyncService MetaSyncService
@inject IMetaCatalogService MetaCatalogService
@inject Microsoft.Extensions.Options.IOptions<Velonixs.Connect.Infrastructure.Configuration.MetaCatalogOptions> MetaCatalogOptions

<header class="page-head">
    <div>
        <p>@_restaurant?.Name</p>
        <h1>Catalog sync</h1>
        <span class="page-description">Connect Meta, publish the menu, and monitor delivery health.</span>
    </div>
    <div class="toolbar page-head-actions">
        <a href="/admin/dashboard">Dashboard</a>
        <a href="/admin/catalog/@BusinessId">Products</a>
    </div>
</header>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="notice">@_message</div>
}

<section class="work-surface mb-3">
    <div class="surface-title">
        <h2>Meta connection</h2>
    </div>
    <form class="portal-form" @onsubmit="SaveSettingsAsync" @onsubmit:preventDefault>
        <div class="portal-form-grid portal-form-grid--three">
            <label><span class="field-label">WABA ID (reference)</span><input @bind="_settings.WabaId" /></label>
            <label><span class="field-label">Meta Business ID</span><input @bind="_settings.MetaBusinessId" placeholder="Business Manager ID" /></label>
            <label><span class="field-label">Catalog ID</span><input @bind="_settings.CatalogId" placeholder="Created here or entered for an existing catalog" /></label>
            <label><span class="field-label">Meta Phone Number ID</span><input @bind="_settings.PhoneNumberId" /></label>
            <label><span class="field-label">Access token</span><input type="password" @bind="_settings.AccessToken" placeholder="Leave blank to keep existing" /></label>
            <label><span class="field-label">Credential reference</span><input @bind="_settings.CredentialReference" placeholder="For example, Key Vault secret name" /></label>
            <label><span class="field-label">Sync mode</span>
                <select @bind="_settings.SyncMode">
                    <option value="default">Default</option>
                    <option value="manual">Manual</option>
                    <option value="automatic">Automatic</option>
                </select>
            </label>
            <label class="check-field"><input type="checkbox" @bind="_settings.IsEnabled" /><span>Connection enabled</span></label>
            <label class="check-field"><input type="checkbox" @bind="_settings.IsCartEnabled" /><span>Cart enabled</span></label>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save connection</button>
        </div>
    </form>
    <p class="text-muted mb-0">
        Access tokens are write-only and encrypted. Save this connection before creating a catalog.
        @if (_settings.LastSuccessfulSyncAt is not null)
        {
            <span> Last successful remote sync: @_settings.LastSuccessfulSyncAt.Value.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt").</span>
        }
    </p>
</section>

<section class="work-surface mb-3">
    <div class="surface-title">
        <h2>Create or connect catalog</h2>
    </div>
    <form class="portal-form" @onsubmit="CreateCatalogAsync" @onsubmit:preventDefault>
        <div class="portal-form-grid portal-form-grid--two">
            <label><span class="field-label">Catalog name</span><input @bind="_catalogName" placeholder="Restaurant catalog" /></label>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-outline-primary" disabled="@(_creatingCatalog || MetaCatalogOptions.Value.DisableSending)">@(_creatingCatalog ? "Creating..." : "Create and connect catalog")</button>
        </div>
    </form>
    @if (MetaCatalogOptions.Value.DisableSending)
    {
        <p class="text-muted mb-0">Catalog creation is disabled in this environment. Enable live Meta sending on the API host to use it.</p>
    }
    else
    {
        <p class="text-muted mb-0">Creates the catalog, connects it to WhatsApp, and queues local products.</p>
    }
</section>

<section class="work-surface mb-3">
    <div class="surface-title">
        <h2>Publish menu</h2>
        <div class="toolbar">
            <button class="btn btn-primary" @onclick="QueueAllAsync">Queue menu for sync</button>
            <button @onclick="ProcessAsync" disabled="@MetaCatalogOptions.Value.DisableSending">Process pending</button>
        </div>
    </div>
    @if (MetaCatalogOptions.Value.DisableSending)
    {
        <p class="text-muted mb-0">This Admin host is configured for dry run. Queue processing is owned by the API worker; enable live sending on that host before relying on remote delivery.</p>
    }
</section>

<section class="work-surface mb-3">
    <div class="surface-title"><div><h2>Queue</h2><p class="surface-description">Products waiting to be processed by the catalog worker.</p></div><span class="count-badge">@_queue.Count total · @FilteredQueue.Count shown</span>@if (HasQueueFilters) { <button class="vx-clear-filters" @onclick="ClearQueueFilters">Clear filters</button> }</div>
    @if (FilteredQueue.Count == 0)
    {
        <div class="vx-empty-state">@(_queue.Count == 0 ? "No catalog sync items found." : "No catalog sync items match the selected filters.")</div>
    }
    else
    {
    <div class="table-responsive">
        <table class="table align-middle sync-queue-table vx-table">
            <thead><tr><th>Product</th><th>Event</th><th>Status</th><th>Retries</th><th>Next</th><th>Error</th><th class="portal-actions-heading">Actions</th></tr><tr class="vx-table-filter-row"><th><input class="vx-table-filter-input" aria-label="Filter queue product" placeholder="Search product" @bind="_queueProductFilter" @bind:event="oninput" /></th><th><input class="vx-table-filter-input" aria-label="Filter event" placeholder="Event" @bind="_queueEventFilter" @bind:event="oninput" /></th><th><input class="vx-table-filter-input" aria-label="Filter queue status" placeholder="Status" @bind="_queueStatusFilter" @bind:event="oninput" /></th><th><input class="vx-table-filter-input" type="number" min="0" aria-label="Minimum retries" placeholder="Min" @bind="_minRetries" /></th><th></th><th><input class="vx-table-filter-input" aria-label="Filter error" placeholder="Search error" @bind="_queueErrorFilter" @bind:event="oninput" /></th><th></th></tr></thead>
            <tbody>
            @foreach (var item in FilteredQueue)
            {
                <tr>
                    <td>@item.ProductName</td>
                    <td>@item.EventType</td>
                    <td><span class="status-pill status-@item.Status.ToLowerInvariant()">@item.Status</span></td>
                    <td>@item.RetryCount</td>
                    <td>@(item.NextAttemptAt?.ToLocalTime().ToString("dd MMM, hh:mm tt") ?? "-")</td>
                    <td>@item.LastError</td>
                    <td class="portal-actions-cell">
                        @if (item.Status == "Failed")
                        {
                            <div class="action-row"><button class="action-primary" @onclick="() => RetryAsync(item.Id)">Retry</button></div>
                        }
                        else if (item.Status == "Waiting")
                        {
                            <span class="text-muted">Waiting for prior sync</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    }
</section>

<section class="work-surface">
    <div class="surface-title"><div><h2>Logs</h2><p class="surface-description">Recent Meta catalog delivery attempts and responses.</p></div><span class="count-badge">@_logs.Count total · @FilteredLogs.Count shown</span>@if (HasLogFilters) { <button class="vx-clear-filters" @onclick="ClearLogFilters">Clear filters</button> }</div>
    @if (FilteredLogs.Count == 0)
    {
        <div class="vx-empty-state">@(_logs.Count == 0 ? "No catalog sync logs found." : "No catalog sync logs match the selected filters.")</div>
    }
    else
    {
    <div class="table-responsive">
        <table class="table align-middle sync-logs-table vx-table">
            <thead><tr><th>Time</th><th>Product</th><th>Event</th><th>Status</th><th>HTTP</th><th>Error</th></tr><tr class="vx-table-filter-row"><th><select class="vx-table-filter-select" aria-label="Filter log date" @bind="_logDateFilter"><option value="">All dates</option><option value="7">Last 7 days</option><option value="30">Last 30 days</option></select></th><th><input class="vx-table-filter-input" aria-label="Filter log product" placeholder="Product" @bind="_logProductFilter" @bind:event="oninput" /></th><th><input class="vx-table-filter-input" aria-label="Filter log event" placeholder="Event" @bind="_logEventFilter" @bind:event="oninput" /></th><th><input class="vx-table-filter-input" aria-label="Filter log status" placeholder="Status" @bind="_logStatusFilter" @bind:event="oninput" /></th><th></th><th><input class="vx-table-filter-input" aria-label="Filter log error" placeholder="Error" @bind="_logErrorFilter" @bind:event="oninput" /></th></tr></thead>
            <tbody>
            @foreach (var log in FilteredLogs)
            {
                <tr>
                    <td>@log.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</td>
                    <td>@log.ProductName</td>
                    <td>@log.EventType</td>
                    <td><span class="status-pill status-@log.Status.ToLowerInvariant()">@log.Status</span></td>
                    <td>@log.ResponseCode</td>
                    <td>@log.ErrorMessage</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    }
</section>

@code {
    [Parameter] public Guid BusinessId { get; set; }

    private RestaurantResponse? _restaurant;
    private SettingsEditor _settings = new();
    private IReadOnlyCollection<CatalogSyncQueueSummary> _queue = Array.Empty<CatalogSyncQueueSummary>();
    private IReadOnlyCollection<CatalogSyncLogSummary> _logs = Array.Empty<CatalogSyncLogSummary>();
    private string? _message;
    private string? _catalogName;
    private bool _creatingCatalog;
    private string _queueProductFilter = string.Empty, _queueEventFilter = string.Empty, _queueStatusFilter = string.Empty, _queueErrorFilter = string.Empty;
    private int? _minRetries;
    private string _logDateFilter = string.Empty, _logProductFilter = string.Empty, _logEventFilter = string.Empty, _logStatusFilter = string.Empty, _logErrorFilter = string.Empty;
    private IReadOnlyCollection<CatalogSyncQueueSummary> FilteredQueue => _queue.Where(item =>
        (string.IsNullOrWhiteSpace(_queueProductFilter) || item.ProductName.Contains(_queueProductFilter, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_queueEventFilter) || item.EventType.Contains(_queueEventFilter, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_queueStatusFilter) || item.Status.Contains(_queueStatusFilter, StringComparison.OrdinalIgnoreCase)) &&
        (_minRetries is null || item.RetryCount >= _minRetries) &&
        (string.IsNullOrWhiteSpace(_queueErrorFilter) || (item.LastError ?? string.Empty).Contains(_queueErrorFilter, StringComparison.OrdinalIgnoreCase))).ToArray();
    private IReadOnlyCollection<CatalogSyncLogSummary> FilteredLogs => _logs.Where(log =>
        (string.IsNullOrWhiteSpace(_logProductFilter) || log.ProductName.Contains(_logProductFilter, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_logEventFilter) || log.EventType.Contains(_logEventFilter, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_logStatusFilter) || log.Status.Contains(_logStatusFilter, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_logErrorFilter) || (log.ErrorMessage ?? string.Empty).Contains(_logErrorFilter, StringComparison.OrdinalIgnoreCase)) &&
        (_logDateFilter == "" || log.CreatedAt >= DateTimeOffset.Now.AddDays(-int.Parse(_logDateFilter)))).ToArray();
    private bool HasQueueFilters => !string.IsNullOrWhiteSpace(_queueProductFilter) || !string.IsNullOrWhiteSpace(_queueEventFilter) || !string.IsNullOrWhiteSpace(_queueStatusFilter) || _minRetries is not null || !string.IsNullOrWhiteSpace(_queueErrorFilter);
    private bool HasLogFilters => !string.IsNullOrWhiteSpace(_logDateFilter) || !string.IsNullOrWhiteSpace(_logProductFilter) || !string.IsNullOrWhiteSpace(_logEventFilter) || !string.IsNullOrWhiteSpace(_logStatusFilter) || !string.IsNullOrWhiteSpace(_logErrorFilter);

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private void ClearQueueFilters() { _queueProductFilter = _queueEventFilter = _queueStatusFilter = _queueErrorFilter = string.Empty; _minRetries = null; }
    private void ClearLogFilters() => (_logDateFilter, _logProductFilter, _logEventFilter, _logStatusFilter, _logErrorFilter) = (string.Empty, string.Empty, string.Empty, string.Empty, string.Empty);

    private async Task LoadAsync()
    {
        _restaurant = await RestaurantService.GetRestaurantAsync(BusinessId);
        if (_restaurant is null)
        {
            _message = "Business was not found.";
            _queue = Array.Empty<CatalogSyncQueueSummary>();
            _logs = Array.Empty<CatalogSyncLogSummary>();
            return;
        }

        var settings = await MetaSyncService.GetSettingsAsync(BusinessId);
        _settings = SettingsEditor.From(settings);
        _catalogName ??= $"{_restaurant.Name} catalog";
        _queue = await MetaSyncService.GetQueueAsync(BusinessId);
        _logs = await MetaSyncService.GetLogsAsync(BusinessId);
    }

    private async Task SaveSettingsAsync()
    {
        try
        {
            await MetaSyncService.SaveSettingsAsync(
                BusinessId,
                new MetaCatalogSettingsInput(
                    _settings.WabaId,
                    _settings.CatalogId,
                    _settings.PhoneNumberId,
                    _settings.AccessToken,
                    null,
                    _settings.IsEnabled,
                    _settings.SyncMode,
                    _settings.MetaBusinessId,
                    _settings.CredentialReference,
                    _settings.IsCartEnabled));
            _message = "Meta catalog settings saved.";
            await LoadAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException or KeyNotFoundException)
        {
            _message = ex.Message;
        }
    }

    private async Task QueueAllAsync()
    {
        var count = await MetaSyncService.QueueAllProductsAsync(BusinessId);
        _message = count == 0
            ? "No products were queued. Check that the Meta connection is enabled and configured."
            : $"Queued {count} product synchronization event(s).";
        await LoadAsync();
    }

    private async Task CreateCatalogAsync()
    {
        if (MetaCatalogOptions.Value.DisableSending)
        {
            _message = "Catalog creation is disabled in this environment.";
            return;
        }

        try
        {
            _creatingCatalog = true;

            // Save the integration credentials first without enabling a
            // connection that has no catalog yet. The create operation then
            // stores the returned Meta catalog ID without any copy/paste.
            await MetaSyncService.SaveSettingsAsync(
                BusinessId,
                new MetaCatalogSettingsInput(
                    _settings.WabaId,
                    null,
                    _settings.PhoneNumberId,
                    _settings.AccessToken,
                    null,
                    IsEnabled: false,
                    SyncMode: _settings.SyncMode,
                    MetaBusinessId: _settings.MetaBusinessId,
                    CredentialReference: _settings.CredentialReference,
                    IsCartEnabled: _settings.IsCartEnabled));

            var catalogId = await MetaCatalogService.CreateCatalogAsync(
                BusinessId,
                string.IsNullOrWhiteSpace(_catalogName) ? $"{_restaurant?.Name} catalog" : _catalogName);
            _settings.CatalogId = catalogId;
            _settings.IsEnabled = true;
            await SaveSettingsAsync();
            _message = $"Catalog {catalogId} was created, attached to WhatsApp, and queued for product sync.";
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException or KeyNotFoundException)
        {
            _message = ex.Message;
        }
        finally
        {
            _creatingCatalog = false;
        }
    }

    private async Task ProcessAsync()
    {
        await MetaSyncService.ProcessPendingAsync();
        _message = "Pending catalog sync work was processed.";
        await LoadAsync();
    }

    private async Task RetryAsync(Guid id)
    {
        _message = await MetaSyncService.RetryQueueItemAsync(BusinessId, id)
            ? "Failed sync queued for retry."
            : "Only failed sync records can be retried.";
        await LoadAsync();
    }

    private sealed class SettingsEditor
    {
        public string? WabaId { get; set; }
        public string? CatalogId { get; set; }
        public string? PhoneNumberId { get; set; }
        public string? AccessToken { get; set; }
        public string? MetaBusinessId { get; set; }
        public string? CredentialReference { get; set; }
        public bool IsEnabled { get; set; }
        public bool IsCartEnabled { get; set; } = true;
        public string SyncMode { get; set; } = "default";
        public DateTimeOffset? LastSuccessfulSyncAt { get; set; }

        public static SettingsEditor From(MetaCatalogSettingsSummary? settings) => new()
        {
            WabaId = settings?.WabaId,
            CatalogId = settings?.CatalogId,
            PhoneNumberId = settings?.PhoneNumberId,
            MetaBusinessId = settings?.MetaBusinessId,
            CredentialReference = settings?.CredentialReference,
            IsEnabled = settings?.IsEnabled ?? true,
            IsCartEnabled = settings?.IsCartEnabled ?? true,
            SyncMode = settings?.SyncMode ?? "default",
            LastSuccessfulSyncAt = settings?.LastSuccessfulSyncAt
        };
    }
}
