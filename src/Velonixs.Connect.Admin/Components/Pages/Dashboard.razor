@page "/admin/dashboard"
@attribute [Authorize(Roles = AppRoles.PlatformAdmin)]
@inject IRestaurantService RestaurantService
@inject IPlatformAdministrationService PlatformAdministrationService
@inject NavigationManager Navigation

<header class="page-head dashboard-head">
    <div>
        <p>Platform admin</p>
        <h1>Dashboard</h1>
        <span class="page-description">Monitor businesses, catalog operations, and commerce activity.</span>
    </div>
    <div class="toolbar page-head-actions">
        <a href="/admin/master-catalog">Master catalog</a>
        <a class="btn btn-primary" href="#business-onboarding">Add business</a>
    </div>
</header>

<section class="metric-grid">
    <article>
        <div class="metric-card-head"><span class="metric-icon metric-icon-blue"><svg class="ui-icon" aria-hidden="true"><use href="/icons/ui-icons.svg#icon-building"></use></svg></span><span>Businesses</span></div>
        <strong>@_businesses.Count</strong>
        <small class="metric-meta">Connected accounts</small>
    </article>
    <article>
        <div class="metric-card-head"><span class="metric-icon metric-icon-green"><svg class="ui-icon" aria-hidden="true"><use href="/icons/ui-icons.svg#icon-box"></use></svg></span><span>Active products</span></div>
        <strong>@_activeProducts</strong>
        <small class="metric-meta">Available for sale</small>
    </article>
    <article>
        <div class="metric-card-head"><span class="metric-icon metric-icon-amber"><svg class="ui-icon" aria-hidden="true"><use href="/icons/ui-icons.svg#icon-clock"></use></svg></span><span>Pending sync</span></div>
        <strong>@_pendingSync</strong>
        <small class="metric-meta">Waiting to publish</small>
    </article>
    <article>
        <div class="metric-card-head"><span class="metric-icon metric-icon-indigo"><svg class="ui-icon" aria-hidden="true"><use href="/icons/ui-icons.svg#icon-receipt"></use></svg></span><span>Today's orders</span></div>
        <strong>@_todaysOrders</strong>
        <small class="metric-meta">Since midnight</small>
    </article>
    <article>
        <div class="metric-card-head"><span class="metric-icon metric-icon-slate"><svg class="ui-icon" aria-hidden="true"><use href="/icons/ui-icons.svg#icon-chart"></use></svg></span><span>Total revenue</span></div>
        <strong>₹@_revenue.ToString("0.##")</strong>
        <small class="metric-meta">All-time gross value</small>
    </article>
</section>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="notice">@_message</div>
}

<section class="work-surface mb-3">
    <div class="surface-title">
        <div>
            <h2>GST defaults</h2>
            <p class="surface-description">Applied automatically when a new business is created.</p>
        </div>
    </div>
    <form class="gst-defaults-form" @onsubmit="SaveTaxAsync" @onsubmit:preventDefault>
        <div class="business-form-grid business-form-grid--two">
            <label><span class="field-label">CGST %</span><input type="number" step="0.01" min="0" max="100" @bind="_tax.CgstPercent" /></label>
            <label><span class="field-label">SGST %</span><input type="number" step="0.01" min="0" max="100" @bind="_tax.SgstPercent" /></label>
        </div>
        <div class="form-actions gst-defaults-actions">
            <button type="submit" class="btn btn-primary">Save defaults</button>
        </div>
    </form>
</section>

<section id="business-onboarding" class="work-surface onboarding-surface mb-3">
    <div class="surface-title">
        <div>
            <h2>Create business</h2>
            <p class="surface-description">Set up the business, WhatsApp connection, and initial owner access.</p>
        </div>
    </div>
    <form class="business-create-form" @onsubmit="CreateBusinessAsync" @onsubmit:preventDefault>
        <section class="business-form-section">
            <h3>Business details</h3>
            <div class="business-form-grid business-form-grid--two">
                <label><span class="field-label">Name <span class="required-marker" aria-hidden="true">*</span></span><input @bind="_newBusiness.Name" required /></label>
                <label><span class="field-label">Type <span class="required-marker" aria-hidden="true">*</span></span>
                    <select @bind="_newBusiness.BusinessType">
                        @foreach (var type in BusinessTypes.All)
                        {
                            <option value="@type">@type</option>
                        }
                    </select>
                </label>
                <label><span class="field-label">Business phone</span><input @bind="_newBusiness.BusinessPhone" /></label>
                <label><span class="field-label">Address</span><input @bind="_newBusiness.Address" /></label>
            </div>
        </section>

        <section class="business-form-section">
            <h3>WhatsApp and notifications</h3>
            <div class="business-form-grid business-form-grid--three">
                <label><span class="field-label">WhatsApp Phone Number ID <span class="required-marker" aria-hidden="true">*</span></span><input @bind="_newBusiness.WhatsAppPhoneNumberId" required /></label>
                <label><span class="field-label">Staff WhatsApp number</span><input @bind="_newBusiness.StaffWhatsAppNumber" /></label>
                <label><span class="field-label">Notification email</span><input type="email" @bind="_newBusiness.NotificationEmail" /></label>
                <label><span class="field-label">CGST %</span><input type="number" step="0.01" min="0" max="100" @bind="_newBusiness.CgstPercent" /></label>
                <label><span class="field-label">SGST %</span><input type="number" step="0.01" min="0" max="100" @bind="_newBusiness.SgstPercent" /></label>
                <label class="check-field"><input type="checkbox" @bind="_newBusiness.IsActive" /> <span>Business is active</span></label>
            </div>
        </section>

        <section class="business-form-section">
            <h3>Owner access</h3>
            <div class="business-form-grid business-form-grid--three">
                <label><span class="field-label">Owner name <span class="required-marker" aria-hidden="true">*</span></span><input @bind="_newBusiness.OwnerName" required /></label>
                <label><span class="field-label">Owner email <span class="required-marker" aria-hidden="true">*</span></span><input type="email" @bind="_newBusiness.OwnerEmail" required /></label>
                <label><span class="field-label">Temporary password <span class="required-marker" aria-hidden="true">*</span></span><input type="password" @bind="_newBusiness.OwnerPassword" required /></label>
            </div>
        </section>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Create business and continue</button>
        </div>
    </form>
</section>

<section class="work-surface">
    <div class="surface-title">
        <div>
            <h2>Businesses</h2>
            <p class="surface-description">Open a workspace to manage its catalog, orders, customers, and integrations.</p>
        </div>
        <span class="count-badge">@_businesses.Count total · @FilteredBusinesses.Count shown</span>
        @if (HasBusinessFilters) { <button class="vx-clear-filters" @onclick="ClearBusinessFilters">Clear filters</button> }
    </div>
    @if (FilteredBusinesses.Count == 0)
    {
        <div class="vx-empty-state">@(_businesses.Count == 0 ? "No businesses yet." : "No businesses found.")</div>
    }
    else
    {
    <div class="table-responsive">
        <table class="table align-middle businesses-table vx-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th>Products</th>
                    <th>Orders</th>
                    <th class="business-actions-heading">Actions</th>
                </tr>
                <tr class="vx-table-filter-row">
                    <th><input class="vx-table-filter-input" aria-label="Filter business" placeholder="Search business" @bind="_businessFilter" @bind:event="oninput" /></th>
                    <th><select class="vx-table-filter-select" aria-label="Filter business type" @bind="_typeFilter"><option value="">All types</option>@foreach (var type in _businesses.Select(x => x.BusinessType).Distinct().Order()) { <option value="@type">@type</option> }</select></th>
                    <th><select class="vx-table-filter-select" aria-label="Filter business status" @bind="_activeFilter"><option value="">All statuses</option><option value="active">Active</option><option value="inactive">Inactive</option></select></th>
                    <th><input class="vx-table-filter-input" type="number" min="0" aria-label="Minimum products" placeholder="Min" @bind="_minProducts" /></th>
                    <th><input class="vx-table-filter-input" type="number" min="0" aria-label="Minimum orders" placeholder="Min" @bind="_minOrders" /></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var business in FilteredBusinesses)
            {
                <tr>
                    <td><strong>@business.Name</strong></td>
                    <td>@business.BusinessType</td>
                    <td><span class="status-pill @(business.IsActive ? "status-success" : "status-neutral")">@((business.IsActive) ? "Active" : "Inactive")</span></td>
                    <td>@business.ActiveProductCount</td>
                    <td>@business.OrderCount</td>
                    <td class="business-actions">
                        <div class="action-row">
                            <a href="/admin/businesses/@business.BusinessId">Settings</a>
                            <a class="action-primary" href="/admin/catalog/@business.BusinessId">Products</a>
                            <a href="/admin/orders/@business.BusinessId">Orders</a>
                            <a href="/admin/customers/@business.BusinessId">Customers</a>
                            <a class="action-catalog" href="/admin/integrations/@business.BusinessId">Catalog sync</a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    }
</section>

@code {
    private IReadOnlyCollection<PlatformBusinessSummary> _businesses = Array.Empty<PlatformBusinessSummary>();
    private int _activeProducts;
    private int _pendingSync;
    private int _todaysOrders;
    private decimal _revenue;
    private string? _message;
    private string _businessFilter = string.Empty;
    private string _typeFilter = string.Empty;
    private string _activeFilter = string.Empty;
    private int? _minProducts;
    private int? _minOrders;
    private TaxEditor _tax = new();
    private BusinessEditor _newBusiness = new();

    private IReadOnlyCollection<PlatformBusinessSummary> FilteredBusinesses => _businesses.Where(business =>
        (string.IsNullOrWhiteSpace(_businessFilter) || business.Name.Contains(_businessFilter, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_typeFilter) || business.BusinessType == _typeFilter) &&
        (string.IsNullOrWhiteSpace(_activeFilter) || (_activeFilter == "active" ? business.IsActive : !business.IsActive)) &&
        (_minProducts is null || business.ActiveProductCount >= _minProducts) &&
        (_minOrders is null || business.OrderCount >= _minOrders)).ToArray();

    private bool HasBusinessFilters => !string.IsNullOrWhiteSpace(_businessFilter) || !string.IsNullOrWhiteSpace(_typeFilter) || !string.IsNullOrWhiteSpace(_activeFilter) || _minProducts is not null || _minOrders is not null;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var dashboard = await PlatformAdministrationService.GetDashboardAsync();
        _businesses = dashboard.Businesses;
        var tax = await RestaurantService.GetPlatformTaxSettingAsync();
        _tax = new TaxEditor { CgstPercent = tax.CgstPercent, SgstPercent = tax.SgstPercent };
        _activeProducts = dashboard.ActiveProductCount;
        _pendingSync = dashboard.PendingCatalogSyncCount;
        _todaysOrders = dashboard.TodaysOrderCount;
        _revenue = dashboard.TotalRevenue;

        _newBusiness.CgstPercent = tax.CgstPercent;
        _newBusiness.SgstPercent = tax.SgstPercent;
    }

    private async Task SaveTaxAsync()
    {
        try
        {
            await RestaurantService.UpdatePlatformTaxSettingAsync(_tax.CgstPercent, _tax.SgstPercent);
            _message = "Platform GST defaults saved.";
            await LoadAsync();
        }
        catch (InvalidOperationException ex)
        {
            _message = ex.Message;
        }
    }

    private async Task CreateBusinessAsync()
    {
        if (string.IsNullOrWhiteSpace(_newBusiness.Name) ||
            string.IsNullOrWhiteSpace(_newBusiness.WhatsAppPhoneNumberId) ||
            string.IsNullOrWhiteSpace(_newBusiness.OwnerName) ||
            string.IsNullOrWhiteSpace(_newBusiness.OwnerEmail) ||
            string.IsNullOrWhiteSpace(_newBusiness.OwnerPassword))
        {
            _message = "Business, WhatsApp phone ID, and owner account details are required.";
            return;
        }

        try
        {
            var restaurant = await PlatformAdministrationService.CreateBusinessWithOwnerAsync(
                new CreateBusinessWithOwnerRequest(
                _newBusiness.Name,
                _newBusiness.BusinessType,
                _newBusiness.WhatsAppPhoneNumberId,
                _newBusiness.BusinessPhone,
                _newBusiness.NotificationEmail,
                _newBusiness.StaffWhatsAppNumber,
                _newBusiness.Address,
                _newBusiness.CgstPercent,
                _newBusiness.SgstPercent,
                _newBusiness.IsActive,
                null,
                _newBusiness.OwnerName,
                _newBusiness.OwnerEmail,
                _newBusiness.OwnerPassword));
            Navigation.NavigateTo($"/admin/businesses/{restaurant.Id}");
        }
        catch (InvalidOperationException ex)
        {
            _message = ex.Message;
        }
    }

    private void ClearBusinessFilters()
    {
        _businessFilter = _typeFilter = _activeFilter = string.Empty;
        _minProducts = _minOrders = null;
    }

    private sealed class TaxEditor
    {
        public decimal CgstPercent { get; set; }
        public decimal SgstPercent { get; set; }
    }

    private sealed class BusinessEditor
    {
        public string Name { get; set; } = string.Empty;
        public string BusinessType { get; set; } = BusinessTypes.Restaurant;
        public string WhatsAppPhoneNumberId { get; set; } = string.Empty;
        public string? BusinessPhone { get; set; }
        public string? NotificationEmail { get; set; }
        public string? StaffWhatsAppNumber { get; set; }
        public string? Address { get; set; }
        public decimal CgstPercent { get; set; }
        public decimal SgstPercent { get; set; }
        public bool IsActive { get; set; } = true;
        public string OwnerName { get; set; } = string.Empty;
        public string OwnerEmail { get; set; } = string.Empty;
        public string OwnerPassword { get; set; } = string.Empty;
    }
}
