@page "/admin/master-catalog"
@attribute [Authorize(Roles = AppRoles.PlatformAdmin)]
@inject IMenuService MenuService

<header class="page-head catalog-page-head">
    <div>
        <p>Platform catalog</p>
        <h1>Master catalog</h1>
        <span class="page-description">Maintain reusable categories and items for every connected business.</span>
    </div>
    <div class="toolbar page-head-actions">
        <a href="/admin/dashboard">Dashboard</a>
    </div>
</header>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="notice">@_message</div>
}

<section class="work-surface mb-3">
    <div class="surface-title">
        <h2>Add category</h2>
    </div>
    <form class="master-catalog-form" @onsubmit="CreateCategoryAsync" @onsubmit:preventDefault>
        <div class="business-form-grid business-form-grid--two">
            <label><span class="field-label">Name <span class="required-marker" aria-hidden="true">*</span></span><input @bind="_newCategory.Name" required /></label>
            <label class="check-field"><input type="checkbox" @bind="_newCategory.IsActive" /><span>Active</span></label>
        </div>
        <div class="form-actions master-catalog-form-actions">
            <button type="submit" class="btn btn-primary">Add category</button>
        </div>
    </form>
</section>

<section class="work-surface mb-3">
    <div class="surface-title">
        <div><h2>Master categories</h2><p class="surface-description">The shared category structure available during business setup.</p></div>
        <span class="count-badge">@_categories.Count total · @FilteredCategories.Count shown</span>
        @if (HasCategoryFilters) { <button class="vx-clear-filters" @onclick="ClearCategoryFilters">Clear filters</button> }
    </div>
    <div class="table-responsive">
        <table class="table align-middle master-catalog-table master-category-table vx-table">
            <thead><tr><th>Name</th><th class="catalog-active-heading">Active</th><th class="catalog-actions-heading">Actions</th></tr><tr class="vx-table-filter-row"><th><input class="vx-table-filter-input" aria-label="Filter master category" placeholder="Search category" @bind="_categoryFilter" @bind:event="oninput" /></th><th><select class="vx-table-filter-select" aria-label="Filter category status" @bind="_categoryActiveFilter"><option value="">All</option><option value="active">Active</option><option value="inactive">Inactive</option></select></th><th></th></tr></thead>
            <tbody>
            @foreach (var category in FilteredCategories)
            {
                <tr>
                    <td><input class="inline-input" @bind="category.Name" /></td>
                    <td class="catalog-active-cell"><input type="checkbox" @bind="category.IsActive" /></td>
                    <td class="catalog-actions-cell">
                        <div class="action-row">
                            <button class="action-primary" @onclick="() => SaveCategoryAsync(category)">Save</button>
                            <button class="action-danger" @onclick="() => DeleteCategoryAsync(category)">Delete</button>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>

<section class="work-surface mb-3">
    <div class="surface-title">
        <h2>Add item</h2>
    </div>
    <form class="master-catalog-form" @onsubmit="CreateItemAsync" @onsubmit:preventDefault>
        <div class="business-form-grid business-form-grid--three">
            <label><span class="field-label">Category <span class="required-marker" aria-hidden="true">*</span></span>
                <select @bind="_newItem.MasterCategoryId" required>
                    @foreach (var category in _categories.Where(x => x.IsActive))
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                </select>
            </label>
            <label><span class="field-label">Name <span class="required-marker" aria-hidden="true">*</span></span><input @bind="_newItem.Name" required /></label>
            <label><span class="field-label">Description</span><input @bind="_newItem.Description" /></label>
        </div>
        <div class="master-catalog-form-footer">
            <label class="check-field"><input type="checkbox" @bind="_newItem.IsActive" /><span>Active</span></label>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Add item</button>
            </div>
        </div>
    </form>
</section>

<section class="work-surface">
    <div class="surface-title">
        <div><h2>Master items</h2><p class="surface-description">Canonical product definitions that businesses can add to their catalogs.</p></div>
        <span class="count-badge">@_items.Count total · @FilteredItems.Count shown</span>
        @if (HasItemFilters) { <button class="vx-clear-filters" @onclick="ClearItemFilters">Clear filters</button> }
    </div>
    <div class="table-responsive">
        <table class="table align-middle master-catalog-table master-item-table vx-table">
            <thead><tr><th>Category</th><th>Name</th><th>Description</th><th class="catalog-active-heading">Active</th><th class="catalog-actions-heading">Actions</th></tr><tr class="vx-table-filter-row"><th><select class="vx-table-filter-select" aria-label="Filter item category" @bind="_itemCategoryFilter"><option value="">All categories</option>@foreach (var category in _categories) { <option value="@category.Id">@category.Name</option> }</select></th><th><input class="vx-table-filter-input" aria-label="Filter master item name" placeholder="Search item" @bind="_itemFilter" @bind:event="oninput" /></th><th><input class="vx-table-filter-input" aria-label="Filter description" placeholder="Search description" @bind="_descriptionFilter" @bind:event="oninput" /></th><th><select class="vx-table-filter-select" aria-label="Filter item active status" @bind="_itemActiveFilter"><option value="">All</option><option value="active">Active</option><option value="inactive">Inactive</option></select></th><th></th></tr></thead>
            <tbody>
            @foreach (var item in FilteredItems)
            {
                <tr>
                    <td>
                        <select class="inline-input" @bind="item.MasterCategoryId">
                            @foreach (var category in _categories)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </select>
                    </td>
                    <td><input class="inline-input" @bind="item.Name" /></td>
                    <td><input class="inline-input" @bind="item.Description" /></td>
                    <td class="catalog-active-cell"><input type="checkbox" @bind="item.IsActive" /></td>
                    <td class="catalog-actions-cell">
                        <div class="action-row">
                            <button class="action-primary" @onclick="() => SaveItemAsync(item)">Save</button>
                            <button class="action-danger" @onclick="() => DeleteItemAsync(item)">Delete</button>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>

@code {
    private readonly List<MasterCategoryEditor> _categories = new();
    private readonly List<MasterItemEditor> _items = new();
    private MasterCategoryEditor _newCategory = new() { IsActive = true };
    private MasterItemEditor _newItem = new() { IsActive = true };
    private string? _message;
    private string _categoryFilter = string.Empty;
    private string _categoryActiveFilter = string.Empty;
    private string _itemCategoryFilter = string.Empty;
    private string _itemFilter = string.Empty;
    private string _descriptionFilter = string.Empty;
    private string _itemActiveFilter = string.Empty;

    private IReadOnlyCollection<MasterCategoryEditor> FilteredCategories => _categories.Where(category =>
        (string.IsNullOrWhiteSpace(_categoryFilter) || category.Name.Contains(_categoryFilter, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_categoryActiveFilter) || (_categoryActiveFilter == "active" ? category.IsActive : !category.IsActive))).ToArray();
    private IReadOnlyCollection<MasterItemEditor> FilteredItems => _items.Where(item =>
        (string.IsNullOrWhiteSpace(_itemCategoryFilter) || item.MasterCategoryId.ToString() == _itemCategoryFilter) &&
        (string.IsNullOrWhiteSpace(_itemFilter) || item.Name.Contains(_itemFilter, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_descriptionFilter) || (item.Description ?? string.Empty).Contains(_descriptionFilter, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_itemActiveFilter) || (_itemActiveFilter == "active" ? item.IsActive : !item.IsActive))).ToArray();
    private bool HasCategoryFilters => !string.IsNullOrWhiteSpace(_categoryFilter) || !string.IsNullOrWhiteSpace(_categoryActiveFilter);
    private bool HasItemFilters => !string.IsNullOrWhiteSpace(_itemCategoryFilter) || !string.IsNullOrWhiteSpace(_itemFilter) || !string.IsNullOrWhiteSpace(_descriptionFilter) || !string.IsNullOrWhiteSpace(_itemActiveFilter);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var catalog = await MenuService.GetMasterCatalogAsync();
        _categories.Clear();
        _items.Clear();
        _categories.AddRange(catalog.Categories.Select(MasterCategoryEditor.From));
        _items.AddRange(catalog.Items.Select(MasterItemEditor.From));
        _newItem.MasterCategoryId = _categories.FirstOrDefault(x => x.IsActive)?.Id ?? Guid.Empty;
    }

    private void ClearCategoryFilters() => (_categoryFilter, _categoryActiveFilter) = (string.Empty, string.Empty);
    private void ClearItemFilters() => (_itemCategoryFilter, _itemFilter, _descriptionFilter, _itemActiveFilter) = (string.Empty, string.Empty, string.Empty, string.Empty);

    private async Task CreateCategoryAsync()
    {
        if (string.IsNullOrWhiteSpace(_newCategory.Name))
        {
            _message = "Enter a valid master category name.";
            return;
        }

        try
        {
            await MenuService.CreateMasterCategoryAsync(
                new CreateMasterMenuCategoryRequest(_newCategory.Name, IsActive: _newCategory.IsActive));
            _newCategory = new MasterCategoryEditor { IsActive = true };
            _message = "Master category added.";
            await LoadAsync();
        }
        catch (InvalidOperationException ex)
        {
            _message = ex.Message;
        }
    }

    private async Task SaveCategoryAsync(MasterCategoryEditor editor)
    {
        if (string.IsNullOrWhiteSpace(editor.Name))
        {
            _message = "Enter a valid master category name.";
            return;
        }

        try
        {
            var category = await MenuService.UpdateMasterCategoryAsync(
                editor.Id,
                new UpdateMasterMenuCategoryRequest(editor.Name, editor.DisplayOrder, editor.IsActive));
            if (category is null)
            {
                _message = "Master category was not found.";
                return;
            }

            _message = "Master category saved.";
            await LoadAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            _message = ex.Message;
        }
    }

    private async Task DeleteCategoryAsync(MasterCategoryEditor editor)
    {
        try
        {
            if (!await MenuService.DeleteMasterCategoryAsync(editor.Id))
            {
                _message = "Master category was not found.";
                return;
            }

            _message = "Master category deleted.";
            await LoadAsync();
        }
        catch (InvalidOperationException ex)
        {
            _message = ex.Message;
        }
    }

    private async Task CreateItemAsync()
    {
        if (_newItem.MasterCategoryId == Guid.Empty || string.IsNullOrWhiteSpace(_newItem.Name))
        {
            _message = "Enter valid master menu item details.";
            return;
        }

        try
        {
            await MenuService.CreateMasterItemAsync(
                new CreateMasterMenuItemRequest(_newItem.MasterCategoryId, _newItem.Name, _newItem.Description, _newItem.IsActive));
            _newItem = new MasterItemEditor { IsActive = true };
            _message = "Master menu item added.";
            await LoadAsync();
        }
        catch (InvalidOperationException ex)
        {
            _message = ex.Message;
        }
    }

    private async Task SaveItemAsync(MasterItemEditor editor)
    {
        if (editor.MasterCategoryId == Guid.Empty || string.IsNullOrWhiteSpace(editor.Name))
        {
            _message = "Enter valid master menu item details.";
            return;
        }

        try
        {
            var item = await MenuService.UpdateMasterItemAsync(
                editor.Id,
                new UpdateMasterMenuItemRequest(
                    editor.MasterCategoryId,
                    editor.Name,
                    editor.Description,
                    editor.IsActive));
            if (item is null)
            {
                _message = "Master menu item was not found.";
                return;
            }

            _message = "Master menu item saved.";
            await LoadAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            _message = ex.Message;
        }
    }

    private async Task DeleteItemAsync(MasterItemEditor editor)
    {
        try
        {
            if (!await MenuService.DeleteMasterItemAsync(editor.Id))
            {
                _message = "Master menu item was not found.";
                return;
            }

            _message = "Master menu item deleted.";
            await LoadAsync();
        }
        catch (InvalidOperationException ex)
        {
            _message = ex.Message;
        }
    }

    private sealed class MasterCategoryEditor
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public int DisplayOrder { get; set; }
        public bool IsActive { get; set; } = true;

        public static MasterCategoryEditor From(MasterMenuCategoryResponse category) => new()
        {
            Id = category.Id,
            Name = category.Name,
            DisplayOrder = category.DisplayOrder,
            IsActive = category.IsActive
        };
    }

    private sealed class MasterItemEditor
    {
        public Guid Id { get; set; }
        public Guid MasterCategoryId { get; set; }
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public bool IsActive { get; set; } = true;

        public static MasterItemEditor From(MasterMenuItemResponse item) => new()
        {
            Id = item.Id,
            MasterCategoryId = item.MasterCategoryId,
            Name = item.Name,
            Description = item.Description,
            IsActive = item.IsActive
        };
    }
}
