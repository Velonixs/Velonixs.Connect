@page "/admin/orders/{BusinessId:guid}"
@attribute [Authorize(Roles = AppRoles.PlatformAdmin)]
@inject IRestaurantService RestaurantService
@inject IOrderService OrderService

<header class="page-head">
    <div>
        <p>@_restaurant?.Name</p>
        <h1>Orders</h1>
        <span class="page-description">Review incoming orders and move them through fulfilment.</span>
    </div>
    <div class="toolbar page-head-actions">
        <a href="/admin/dashboard">Dashboard</a>
        <a href="/admin/catalog/@BusinessId">Products</a>
    </div>
</header>

<section class="work-surface">
    <div class="surface-title">
        <div><h2>Order list</h2><p class="surface-description">Update status and add an operational comment without leaving the queue.</p></div>
        <span class="count-badge">@_orders.Count total · @FilteredOrders.Count shown</span>
        @if (HasActiveFilters) { <button class="vx-clear-filters" @onclick="ClearFilters">Clear filters</button> }
    </div>
    @if (FilteredOrders.Count == 0)
    {
        <div class="vx-empty-state">@(_orders.Count == 0 ? "No orders found." : "No orders match the selected filters.")</div>
    }
    else
    {
    <div class="table-responsive">
        <table class="table align-middle orders-table vx-table">
            <thead>
                <tr>
                    <th>Order</th>
                    <th>Customer</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th class="portal-actions-heading">Actions</th>
                </tr>
                <tr class="vx-table-filter-row">
                    <th><input class="vx-table-filter-input" aria-label="Filter order number" placeholder="Search order" @bind="_orderFilter" @bind:event="oninput" /></th>
                    <th><input class="vx-table-filter-input" aria-label="Filter customer" placeholder="Search customer" @bind="_customerFilter" @bind:event="oninput" /></th>
                    <th><input class="vx-table-filter-input" type="number" min="0" aria-label="Minimum amount" placeholder="Min amount" @bind="_minAmount" /></th>
                    <th><select class="vx-table-filter-select" aria-label="Filter order status" @bind="_statusFilter"><option value="">All statuses</option>@foreach (var status in _statusOptions) { <option value="@status">@status</option> }</select></th>
                    <th><select class="vx-table-filter-select" aria-label="Filter created date" @bind="_dateFilter"><option value="">All dates</option><option value="today">Today</option><option value="7">Last 7 days</option><option value="30">Last 30 days</option></select></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var order in FilteredOrders)
            {
                <tr>
                    <td><strong>@order.OrderNumber</strong></td>
                    <td>@order.CustomerName<br /><small>@order.CustomerPhone</small></td>
                    <td>Rs @order.TotalAmount.ToString("0.##")</td>
                    <td>
                        <select class="inline-input" @bind="order.NextStatus">
                            @foreach (var status in _statusOptions)
                            {
                                <option value="@status">@status</option>
                            }
                        </select>
                    </td>
                    <td>@order.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</td>
                    <td class="portal-actions-cell">
                        <div class="action-row">
                            <input class="inline-input" placeholder="Comment" @bind="order.Comment" />
                            <button class="action-primary" @onclick="() => UpdateStatusAsync(order)">Save status</button>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    }
</section>

@code {
    [Parameter] public Guid BusinessId { get; set; }

    private RestaurantResponse? _restaurant;
    private readonly List<OrderEditor> _orders = new();
    private string _orderFilter = string.Empty;
    private string _customerFilter = string.Empty;
    private decimal? _minAmount;
    private string _statusFilter = string.Empty;
    private string _dateFilter = string.Empty;
    private readonly string[] _statusOptions =
    [
        OrderStatuses.PendingConfirmation,
        OrderStatuses.Confirmed,
        OrderStatuses.Preparing,
        OrderStatuses.ReadyForPickup,
        OrderStatuses.OutForDelivery,
        OrderStatuses.Delivered,
        OrderStatuses.Rejected,
        OrderStatuses.Cancelled,
        OrderStatuses.Failed
    ];

    private IReadOnlyCollection<OrderEditor> FilteredOrders => _orders.Where(order =>
        (string.IsNullOrWhiteSpace(_orderFilter) || order.OrderNumber.Contains(_orderFilter, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_customerFilter) || order.CustomerName.Contains(_customerFilter, StringComparison.OrdinalIgnoreCase) || order.CustomerPhone.Contains(_customerFilter, StringComparison.OrdinalIgnoreCase)) &&
        (_minAmount is null || order.TotalAmount >= _minAmount) &&
        (string.IsNullOrWhiteSpace(_statusFilter) || order.NextStatus == _statusFilter) &&
        MatchesDate(order.CreatedAt)).ToArray();

    private bool HasActiveFilters => !string.IsNullOrWhiteSpace(_orderFilter) || !string.IsNullOrWhiteSpace(_customerFilter) || _minAmount is not null || !string.IsNullOrWhiteSpace(_statusFilter) || !string.IsNullOrWhiteSpace(_dateFilter);

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _restaurant = await RestaurantService.GetRestaurantAsync(BusinessId);
        _orders.Clear();
        _orders.AddRange((await OrderService.GetRestaurantOrdersAsync(BusinessId)).Select(OrderEditor.From));
    }

    private async Task UpdateStatusAsync(OrderEditor order)
    {
        await OrderService.UpdateStatusAsync(order.Id, new UpdateOrderStatusRequest(order.NextStatus, order.Comment, "Platform admin", null));
        await LoadAsync();
    }

    private bool MatchesDate(DateTimeOffset createdAt) => _dateFilter switch
    {
        "today" => createdAt.LocalDateTime.Date == DateTime.Today,
        "7" => createdAt >= DateTimeOffset.Now.AddDays(-7),
        "30" => createdAt >= DateTimeOffset.Now.AddDays(-30),
        _ => true
    };

    private void ClearFilters()
    {
        _orderFilter = _customerFilter = _statusFilter = _dateFilter = string.Empty;
        _minAmount = null;
    }

    private sealed class OrderEditor
    {
        public Guid Id { get; set; }
        public string OrderNumber { get; set; } = string.Empty;
        public string CustomerName { get; set; } = string.Empty;
        public string CustomerPhone { get; set; } = string.Empty;
        public decimal TotalAmount { get; set; }
        public string NextStatus { get; set; } = string.Empty;
        public string? Comment { get; set; }
        public DateTimeOffset CreatedAt { get; set; }

        public static OrderEditor From(OrderSummaryResponse order) => new()
        {
            Id = order.Id,
            OrderNumber = order.OrderNumber,
            CustomerName = order.CustomerName,
            CustomerPhone = order.CustomerPhone,
            TotalAmount = order.TotalAmount,
            NextStatus = order.OrderStatus,
            CreatedAt = order.CreatedAt
        };
    }
}
