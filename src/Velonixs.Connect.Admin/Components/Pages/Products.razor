@page "/admin/catalog/{BusinessId:guid}"
@attribute [Authorize(Roles = AppRoles.PlatformAdmin)]
@inject IRestaurantService RestaurantService
@inject IMenuService MenuService
@inject IMetaCatalogSyncService MetaSyncService

<header class="page-head">
    <div>
        <p>@_restaurant?.Name</p>
        <h1>Products & Categories</h1>
        <span class="page-description">Build the sellable catalog and control product availability.</span>
    </div>
    <div class="toolbar page-head-actions">
        <a href="/admin/dashboard">Dashboard</a>
        <a href="/admin/integrations/@BusinessId">Catalog Sync</a>
    </div>
</header>

<section class="work-surface mb-3">
    <div class="surface-title">
        <h2>Add category</h2>
    </div>
    <form class="portal-form" @onsubmit="CreateCategoryAsync" @onsubmit:preventDefault>
        <div class="portal-form-grid portal-form-grid--three">
            <label><span class="field-label">Master category <span class="required-marker" aria-hidden="true">*</span></span>
                <select @bind="_newCategory.MasterCategoryId" required>
                    <option value="@Guid.Empty" disabled>Select a master category</option>
                    @foreach (var category in _masterCategories.Where(category => category.IsActive))
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                </select>
            </label>
            <label><span class="field-label">Display order</span><input type="number" @bind="_newCategory.DisplayOrder" /></label>
            <label class="check-field"><input type="checkbox" @bind="_newCategory.IsActive" /><span>Active</span></label>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Add category</button>
        </div>
    </form>
</section>

<section class="work-surface mb-3">
    <div class="surface-title">
        <div><h2>Categories</h2><p class="surface-description">Organize products using the platform master catalog.</p></div>
        <span class="count-badge">@_categories.Count total · @FilteredCategories.Count shown</span>
        @if (HasCategoryFilters) { <button class="vx-clear-filters" @onclick="ClearCategoryFilters">Clear filters</button> }
    </div>
    <div class="table-responsive">
        <table class="table align-middle categories-table vx-table">
            <thead><tr><th>Master category</th><th>Order</th><th class="portal-active-heading">Active</th><th class="portal-actions-heading">Actions</th></tr><tr class="vx-table-filter-row"><th><input class="vx-table-filter-input" aria-label="Filter category" placeholder="Search category" @bind="_categoryFilter" @bind:event="oninput" /></th><th></th><th><select class="vx-table-filter-select" aria-label="Filter category active status" @bind="_categoryActiveFilter"><option value="">All</option><option value="active">Active</option><option value="inactive">Inactive</option></select></th><th></th></tr></thead>
            <tbody>
            @foreach (var category in FilteredCategories)
            {
                <tr>
                    <td>@GetMasterCategoryName(category)</td>
                    <td><input class="inline-input" type="number" @bind="category.DisplayOrder" /></td>
                    <td class="portal-active-cell"><input type="checkbox" @bind="category.IsActive" /></td>
                    <td class="portal-actions-cell">
                        <div class="action-row">
                            <button class="action-primary" @onclick="() => SaveCategoryAsync(category)">Save</button>
                            <button @onclick="() => DeactivateCategoryAsync(category)">Deactivate</button>
                            <button class="action-danger" @onclick="() => DeleteCategoryAsync(category)">Delete</button>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>

<section class="work-surface mb-3">
    <div class="surface-title">
        <h2>Add product</h2>
    </div>
    <form class="portal-form" @onsubmit="CreateProductAsync" @onsubmit:preventDefault>
        <div class="portal-form-grid portal-form-grid--three">
            <label><span class="field-label">Category <span class="required-marker" aria-hidden="true">*</span></span>
                <select @bind="_newProduct.CategoryId" @bind:after="ResetNewProductMasterItem" required>
                    @foreach (var category in _categories.Where(x => x.IsActive))
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                </select>
            </label>
            <label><span class="field-label">Master item <span class="required-marker" aria-hidden="true">*</span></span>
                <select @bind="_newProduct.MasterMenuItemId" @bind:after="ApplySelectedMasterItem" required>
                    <option value="@Guid.Empty" disabled>Select a master item</option>
                    @foreach (var item in GetMasterItemsForCategory(_newProduct.CategoryId))
                    {
                        <option value="@item.Id">@item.Name</option>
                    }
                </select>
                <small class="portal-field-help">Products are defined in the master catalog.</small>
            </label>
            <label><span class="field-label">Code <span class="required-marker" aria-hidden="true">*</span></span><input type="number" min="1" @bind="_newProduct.ItemCode" required /></label>
            <label><span class="field-label">Name</span><input @bind="_newProduct.Name" readonly /></label>
            <label><span class="field-label">Price <span class="required-marker" aria-hidden="true">*</span></span><input type="number" min="0" step="0.01" @bind="_newProduct.Price" required /></label>
            <label><span class="field-label">SKU</span><input @bind="_newProduct.ProductRetailerId" /></label>
            <label><span class="field-label">Image URL</span><input @bind="_newProduct.ImageUrl" /><small class="portal-field-help">Required for Meta sync (public HTTPS).</small></label>
            <label class="portal-form-field--span-two"><span class="field-label">Description</span><input @bind="_newProduct.Description" readonly /></label>
            <label><span class="field-label">Menu type</span>
                <select @bind="_newProduct.IsVegetarian">
                    <option value="true">Vegetarian</option>
                    <option value="false">Non-vegetarian</option>
                </select>
            </label>
        </div>
        <div class="portal-form-footer">
            <div class="portal-check-group">
                <label class="check-field"><input type="checkbox" @bind="_newProduct.IsAvailable" /><span>Available</span></label>
                <label class="check-field"><input type="checkbox" @bind="_newProduct.IsActive" /><span>Active</span></label>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Add product</button>
            </div>
        </div>
    </form>
</section>

<section class="work-surface">
    <div class="surface-title">
        <div><h2>Products</h2><p class="surface-description">Edit pricing, stock, identifiers, and catalog sync state inline.</p></div>
        <span class="count-badge">@_products.Count total · @FilteredProducts.Count shown</span>
        @if (HasProductFilters) { <button class="vx-clear-filters" @onclick="ClearProductFilters">Clear filters</button> }
    </div>
    <div class="table-responsive">
        <table class="table align-middle products-table vx-table">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Category</th>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Price</th>
                    <th>SKU</th>
                    <th>Image</th>
                    <th>Status</th>
                    <th class="portal-actions-heading">Actions</th>
                </tr>
                <tr class="vx-table-filter-row"><th><input class="vx-table-filter-input" aria-label="Filter product code" placeholder="Code" @bind="_productCodeFilter" @bind:event="oninput" /></th><th><select class="vx-table-filter-select" aria-label="Filter category" @bind="_productCategoryFilter"><option value="">All categories</option>@foreach (var category in _categories) { <option value="@category.Id">@category.Name</option> }</select></th><th><input class="vx-table-filter-input" aria-label="Filter product name" placeholder="Search name" @bind="_productNameFilter" @bind:event="oninput" /></th><th><select class="vx-table-filter-select" aria-label="Filter menu type" @bind="_vegetarianFilter"><option value="">All types</option><option value="veg">Vegetarian</option><option value="nonveg">Non-vegetarian</option></select></th><th><input class="vx-table-filter-input" type="number" min="0" aria-label="Minimum price" placeholder="Min price" @bind="_minPrice" /></th><th><input class="vx-table-filter-input" aria-label="Filter SKU" placeholder="Search SKU" @bind="_skuFilter" @bind:event="oninput" /></th><th></th><th><select class="vx-table-filter-select" aria-label="Filter availability" @bind="_availabilityFilter"><option value="">All</option><option value="available">Available</option><option value="soldout">Sold out</option></select></th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var item in FilteredProducts)
            {
                <tr>
                    <td><input class="inline-input" type="number" @bind="item.ItemCode" /></td>
                    <td>
                        <select class="inline-input" @bind="item.CategoryId">
                            @foreach (var category in _categories)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </select>
                    </td>
                    <td><input class="inline-input" @bind="item.Name" /></td>
                    <td>
                        <select class="inline-input" @bind="item.IsVegetarian">
                            <option value="true">Vegetarian</option>
                            <option value="false">Non-vegetarian</option>
                        </select>
                    </td>
                    <td><input class="inline-input" type="number" step="0.01" @bind="item.Price" /></td>
                    <td><input class="inline-input" @bind="item.ProductRetailerId" disabled="@item.IsSkuLocked" /></td>
                    <td><input class="inline-input" @bind="item.ImageUrl" /></td>
                    <td><span class="status-pill">@item.SyncStatus</span></td>
                    <td class="portal-actions-cell">
                        <div class="action-row">
                            <label class="compact-check"><input type="checkbox" @bind="item.IsAvailable" /> Stock</label>
                            <label class="compact-check"><input type="checkbox" @bind="item.IsActive" /> Active</label>
                            <button class="action-primary" @onclick="() => SaveProductAsync(item)">Save</button>
                            <button class="action-catalog" @onclick="() => QueueProductAsync(item)">Sync</button>
                            <button @onclick="() => DeactivateProductAsync(item)">Deactivate</button>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>

@code {
    [Parameter] public Guid BusinessId { get; set; }

    private RestaurantResponse? _restaurant;
    private readonly List<CategoryEditor> _categories = new();
    private readonly List<ProductEditor> _products = new();
    private IReadOnlyCollection<MasterMenuCategoryResponse> _masterCategories = Array.Empty<MasterMenuCategoryResponse>();
    private IReadOnlyCollection<MasterMenuItemResponse> _masterItems = Array.Empty<MasterMenuItemResponse>();
    private CategoryEditor _newCategory = new();
    private ProductEditor _newProduct = new() { IsActive = true, IsAvailable = true };
    private string _categoryFilter = string.Empty;
    private string _categoryActiveFilter = string.Empty;
    private string _productCodeFilter = string.Empty;
    private string _productNameFilter = string.Empty;
    private string _productCategoryFilter = string.Empty;
    private string _vegetarianFilter = string.Empty;
    private decimal? _minPrice;
    private string _skuFilter = string.Empty;
    private string _availabilityFilter = string.Empty;

    private IReadOnlyCollection<CategoryEditor> FilteredCategories => _categories.Where(category =>
        (string.IsNullOrWhiteSpace(_categoryFilter) || GetMasterCategoryName(category).Contains(_categoryFilter, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_categoryActiveFilter) || (_categoryActiveFilter == "active" ? category.IsActive : !category.IsActive))).ToArray();
    private IReadOnlyCollection<ProductEditor> FilteredProducts => _products.Where(item =>
        (string.IsNullOrWhiteSpace(_productCodeFilter) || item.ItemCode.ToString().Contains(_productCodeFilter, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_productNameFilter) || item.Name.Contains(_productNameFilter, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_productCategoryFilter) || item.CategoryId.ToString() == _productCategoryFilter) &&
        (string.IsNullOrWhiteSpace(_vegetarianFilter) || (_vegetarianFilter == "veg" ? item.IsVegetarian : !item.IsVegetarian)) &&
        (_minPrice is null || item.Price >= _minPrice) &&
        (string.IsNullOrWhiteSpace(_skuFilter) || (item.ProductRetailerId ?? string.Empty).Contains(_skuFilter, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_availabilityFilter) || (_availabilityFilter == "available" ? item.IsAvailable : !item.IsAvailable))).ToArray();
    private bool HasCategoryFilters => !string.IsNullOrWhiteSpace(_categoryFilter) || !string.IsNullOrWhiteSpace(_categoryActiveFilter);
    private bool HasProductFilters => !string.IsNullOrWhiteSpace(_productCodeFilter) || !string.IsNullOrWhiteSpace(_productNameFilter) || !string.IsNullOrWhiteSpace(_productCategoryFilter) || !string.IsNullOrWhiteSpace(_vegetarianFilter) || _minPrice is not null || !string.IsNullOrWhiteSpace(_skuFilter) || !string.IsNullOrWhiteSpace(_availabilityFilter);

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _restaurant = await RestaurantService.GetRestaurantAsync(BusinessId);
        var menu = await MenuService.GetMenuAsync(BusinessId);
        var masterCatalog = await MenuService.GetMasterCatalogAsync();
        _categories.Clear();
        _products.Clear();
        _masterCategories = masterCatalog.Categories;
        _masterItems = masterCatalog.Items;

        if (menu is not null)
        {
            _categories.AddRange(menu.Categories.Select(CategoryEditor.From));
            _products.AddRange(menu.Items.OrderBy(x => x.ItemCode).Select(ProductEditor.From));
        }

        _newProduct = new ProductEditor
        {
            CategoryId = _categories.FirstOrDefault(x => x.IsActive)?.Id ?? Guid.Empty,
            ItemCode = (_products.Select(x => x.ItemCode).DefaultIfEmpty().Max()) + 1,
            IsActive = true,
            IsAvailable = true
        };

        if (_newCategory.MasterCategoryId == Guid.Empty ||
            !_masterCategories.Any(category => category.Id == _newCategory.MasterCategoryId && category.IsActive))
        {
            _newCategory.MasterCategoryId = _masterCategories.FirstOrDefault(category => category.IsActive)?.Id ?? Guid.Empty;
        }
    }

    private async Task CreateCategoryAsync()
    {
        var masterCategory = _masterCategories.FirstOrDefault(category =>
            category.Id == _newCategory.MasterCategoryId && category.IsActive);
        if (masterCategory is not null)
        {
            await MenuService.CreateCategoryAsync(
                BusinessId,
                new CreateMenuCategoryRequest(
                    masterCategory.Name,
                    _newCategory.DisplayOrder,
                    _newCategory.IsActive,
                    masterCategory.Id));
            _newCategory = new CategoryEditor { IsActive = true };
            await LoadAsync();
        }
    }

    private async Task SaveCategoryAsync(CategoryEditor category)
    {
        await MenuService.UpdateCategoryAsync(category.Id, new UpdateMenuCategoryRequest(category.Name, category.DisplayOrder, category.IsActive));
        await LoadAsync();
    }

    private async Task DeactivateCategoryAsync(CategoryEditor category)
    {
        await MenuService.DeactivateCategoryAsync(category.Id);
        await LoadAsync();
    }

    private async Task DeleteCategoryAsync(CategoryEditor category)
    {
        try
        {
            await MenuService.DeleteCategoryAsync(category.Id);
            await LoadAsync();
        }
        catch (InvalidOperationException)
        {
        }
    }

    private async Task CreateProductAsync()
    {
        var masterItem = GetMasterItemsForCategory(_newProduct.CategoryId)
            .FirstOrDefault(item => item.Id == _newProduct.MasterMenuItemId);
        if (masterItem is not null)
        {
            var item = await MenuService.CreateItemAsync(
                BusinessId,
                new CreateMenuItemRequest(
                    _newProduct.CategoryId,
                    masterItem.Id,
                    _newProduct.ItemCode,
                    _newProduct.Name,
                    _newProduct.Description,
                    _newProduct.Price,
                    _newProduct.IsAvailable,
                    _newProduct.IsActive,
                    _newProduct.ProductRetailerId,
                    _newProduct.ImageUrl,
                    IsVegetarian: _newProduct.IsVegetarian));
            await LoadAsync();
        }
    }

    private IEnumerable<MasterMenuItemResponse> GetMasterItemsForCategory(Guid restaurantCategoryId)
    {
        var masterCategoryId = _categories
            .FirstOrDefault(category => category.Id == restaurantCategoryId)
            ?.MasterCategoryId;

        return masterCategoryId is Guid id
            ? _masterItems.Where(item => item.IsActive && item.MasterCategoryId == id)
            : Enumerable.Empty<MasterMenuItemResponse>();
    }

    private void ResetNewProductMasterItem()
    {
        _newProduct.MasterMenuItemId = Guid.Empty;
        _newProduct.Name = string.Empty;
        _newProduct.Description = null;
    }

    private void ClearCategoryFilters() => (_categoryFilter, _categoryActiveFilter) = (string.Empty, string.Empty);
    private void ClearProductFilters()
    {
        _productCodeFilter = _productNameFilter = _productCategoryFilter = _vegetarianFilter = _skuFilter = _availabilityFilter = string.Empty;
        _minPrice = null;
    }

    private void ApplySelectedMasterItem()
    {
        var masterItem = GetMasterItemsForCategory(_newProduct.CategoryId)
            .FirstOrDefault(item => item.Id == _newProduct.MasterMenuItemId);
        if (masterItem is null)
        {
            return;
        }

        _newProduct.Name = masterItem.Name;
        _newProduct.Description = masterItem.Description;
    }

    private async Task SaveProductAsync(ProductEditor item)
    {
        await MenuService.UpdateItemAsync(
            item.Id,
            new UpdateMenuItemRequest(
                item.CategoryId,
                null,
                item.ItemCode,
                item.Name,
                item.Description,
                item.Price,
                item.IsAvailable,
                item.IsActive,
                item.ProductRetailerId,
                item.ImageUrl,
                IsVegetarian: item.IsVegetarian));
        await LoadAsync();
    }

    private async Task QueueProductAsync(ProductEditor item)
    {
        await MetaSyncService.QueueProductSyncAsync(BusinessId, item.Id, item.IsActive ? "update" : "delete", force: true);
        await LoadAsync();
    }

    private async Task DeactivateProductAsync(ProductEditor item)
    {
        await MenuService.DeactivateItemAsync(item.Id);
        await LoadAsync();
    }

    private string GetMasterCategoryName(CategoryEditor category) =>
        _masterCategories.FirstOrDefault(master => master.Id == category.MasterCategoryId)?.Name
        ?? category.Name;

    private sealed class CategoryEditor
    {
        public Guid Id { get; set; }
        public Guid? MasterCategoryId { get; set; }
        public string Name { get; set; } = string.Empty;
        public int DisplayOrder { get; set; }
        public bool IsActive { get; set; } = true;

        public static CategoryEditor From(MenuCategoryResponse category) => new()
        {
            Id = category.Id,
            MasterCategoryId = category.MasterCategoryId,
            Name = category.Name,
            DisplayOrder = category.DisplayOrder,
            IsActive = category.IsActive
        };
    }

    private sealed class ProductEditor
    {
        public Guid Id { get; set; }
        public Guid CategoryId { get; set; }
        public Guid MasterMenuItemId { get; set; }
        public int ItemCode { get; set; }
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public decimal Price { get; set; }
        public string? ProductRetailerId { get; set; }
        public string? ImageUrl { get; set; }
        public string? MetaProductId { get; set; }
        public string SyncStatus { get; set; } = "NotQueued";
        public bool IsVegetarian { get; set; }
        public bool IsAvailable { get; set; } = true;
        public bool IsActive { get; set; } = true;
        public bool IsSkuLocked => !string.IsNullOrWhiteSpace(ProductRetailerId);

        public static ProductEditor From(MenuItemResponse item) => new()
        {
            Id = item.Id,
            CategoryId = item.CategoryId,
            ItemCode = item.ItemCode,
            Name = item.Name,
            Description = item.Description,
            Price = item.Price,
            ProductRetailerId = item.ProductRetailerId,
            ImageUrl = item.ImageUrl,
            MetaProductId = item.MetaProductId,
            SyncStatus = item.SyncStatus,
            IsVegetarian = item.IsVegetarian,
            IsAvailable = item.IsAvailable,
            IsActive = item.IsActive
        };
    }
}
