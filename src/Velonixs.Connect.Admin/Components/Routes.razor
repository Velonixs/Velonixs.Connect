<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(AdminBlazorLayout)">
                <NotAuthorized>
                    <div class="blazor-auth-message">Sign in as a platform admin to open the Blazor admin.</div>
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(AdminBlazorLayout)">
                <h1>Not found</h1>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
