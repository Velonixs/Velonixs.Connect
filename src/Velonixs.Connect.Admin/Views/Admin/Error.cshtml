@{
    ViewData["Title"] = "Error";
    var statusCode = ViewData["StatusCode"] as int?;
    var requestId = ViewData["RequestId"] as string;
}

<section class="page-title">
    <div>
        <p class="eyebrow">Admin</p>
        <h1>Something went wrong</h1>
    </div>
    <a class="button secondary" asp-action="Index">Back to dashboard</a>
</section>

<section class="section-band">
    @if (statusCode is 404)
    {
        <p>The page or record you requested could not be found.</p>
    }
    else if (statusCode is 403)
    {
        <p>You do not have permission to complete this request.</p>
    }
    else
    {
        <p>The admin UI could not complete the request. Please try again. If the problem continues, check the application logs.</p>
    }

    @if (!string.IsNullOrWhiteSpace(requestId))
    {
        <p><small>Request ID: @requestId</small></p>
    }
</section>
