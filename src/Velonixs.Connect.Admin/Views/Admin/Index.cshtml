@model AdminIndexViewModel
@{
    ViewData["Title"] = "Admin";
}

<section class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 mb-4">
    <div>
        <p class="eyebrow">Admin</p>
        <h1>Business Operations</h1>
    </div>
    <a class="btn btn-outline-success" href="#create-restaurant">Add business</a>
</section>

<section class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-4"><div class="metric h-100">
        <span>Businesses</span>
        <strong>@Model.TotalRestaurants</strong>
        <small>@Model.ActiveRestaurants active</small>
    </div></div>
    <div class="col-12 col-sm-6 col-xl-4"><div class="metric h-100">
        <span>Orders</span>
        <strong>@Model.TotalOrders</strong>
        <small>Across all businesses</small>
    </div></div>
    <div class="col-12 col-sm-6 col-xl-4"><div class="metric h-100">
        <span>Revenue</span>
        <strong>Rs @Model.TotalRevenue.ToString("0.##")</strong>
        <small>Recorded orders</small>
    </div></div>
</section>

<section class="card shadow-sm mb-4">
    <div class="card-body">
    <div class="section-heading">
        <div>
            <h2>Master Catalog</h2>
            <p class="text-secondary mb-0">Create common categories and menu items once. Restaurants can map these items and set their own price/stock.</p>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12 col-lg-5">
            <form class="card h-100 bg-light border-0 p-3" asp-action="CreateMasterCategory" method="post">
                @Html.AntiForgeryToken()
                <h3 class="h5">Add master category</h3>
                <div class="row g-2">
                    <div class="col-12 col-md-7">
                        <label class="form-label">Category name</label>
                        <input class="form-control" asp-for="NewMasterCategory.Name" name="Name" placeholder="Pizza, Burger, Main Course" required />
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label">Order</label>
                        <input class="form-control" asp-for="NewMasterCategory.DisplayOrder" name="DisplayOrder" type="number" />
                    </div>
                    <div class="col-12 col-md-2 d-flex align-items-end">
                        <div class="form-check">
                            <input class="form-check-input" asp-for="NewMasterCategory.IsActive" name="IsActive" />
                            <label class="form-check-label">Active</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <button class="btn btn-success" type="submit">Add category</button>
                    </div>
                </div>
            </form>
        </div>

        <div class="col-12 col-lg-7">
            <form class="card h-100 bg-light border-0 p-3" asp-action="CreateMasterItem" method="post">
                @Html.AntiForgeryToken()
                <h3 class="h5">Add master menu item</h3>
                @if ((Model.MasterCatalog?.Categories ?? Array.Empty<MasterMenuCategoryResponse>()).Any(x => x.IsActive))
                {
                    <div class="row g-2">
                        <div class="col-12 col-md-4">
                            <label class="form-label">Master category</label>
                            <select class="form-select" asp-for="NewMasterItem.MasterCategoryId" name="MasterCategoryId" required>
                                @foreach (var category in (Model.MasterCatalog?.Categories ?? Array.Empty<MasterMenuCategoryResponse>()).Where(x => x.IsActive))
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label">Item name</label>
                            <input class="form-control" asp-for="NewMasterItem.Name" name="Name" placeholder="Paneer Pizza" required />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label">Description</label>
                            <input class="form-control" asp-for="NewMasterItem.Description" name="Description" />
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" asp-for="NewMasterItem.IsActive" name="IsActive" />
                                <label class="form-check-label">Active</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <button class="btn btn-success" type="submit">Add master item</button>
                        </div>
                    </div>
                }
                else
                {
                    <p class="text-secondary mb-0">Add an active master category first.</p>
                }
            </form>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Category</th>
                    <th>Menu item</th>
                    <th>Description</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.MasterCatalog?.Items ?? Array.Empty<MasterMenuItemResponse>())
            {
                <tr>
                    <td>@item.MasterCategoryName</td>
                    <td><strong>@item.Name</strong></td>
                    <td>@item.Description</td>
                    <td><span class="badge @(item.IsActive ? "text-bg-success" : "text-bg-secondary")">@(item.IsActive ? "Active" : "Inactive")</span></td>
                </tr>
            }
            @if (!(Model.MasterCatalog?.Items ?? Array.Empty<MasterMenuItemResponse>()).Any())
            {
                <tr>
                    <td colspan="4" class="text-secondary">No master menu items yet.</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    </div>
</section>

<section class="card shadow-sm mb-4">
    <div class="card-body">
    <div class="section-heading">
        <h2>Businesses</h2>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Type</th>
                    <th>WhatsApp phone id</th>
                    <th>Catalog</th>
                    <th>Customers</th>
                    <th>Orders</th>
                    <th>Revenue</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Restaurants)
            {
                <tr>
                    <td>
                        <strong>@item.Restaurant.Name</strong>
                        <small>@item.Restaurant.BusinessPhone</small>
                    </td>
                    <td>@item.Restaurant.BusinessType</td>
                    <td><code>@item.Restaurant.WhatsAppPhoneNumberId</code></td>
                    <td>@item.MenuItemCount</td>
                    <td>@item.CustomerCount</td>
                    <td>@item.OrderCount</td>
                    <td>Rs @item.Revenue.ToString("0.##")</td>
                    <td><span class="pill @(item.Restaurant.IsActive ? "good" : "muted")">@(item.Restaurant.IsActive ? "Active" : "Inactive")</span></td>
                    <td class="text-end"><a class="btn btn-sm btn-success" asp-action="Restaurant" asp-route-id="@item.Restaurant.Id">Manage</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    </div>
</section>

<section id="create-restaurant" class="card shadow-sm">
    <div class="card-body">
    <div class="section-heading">
        <h2>Add Business</h2>
    </div>

    <form class="row g-3" asp-action="CreateRestaurant" method="post">
        @Html.AntiForgeryToken()
        <div class="col-12 col-md-6">
            <label class="form-label">Name</label>
            <input class="form-control" asp-for="NewRestaurant.Name" name="Name" required />
        </div>
        <div class="col-12 col-md-6">
            <label class="form-label">Business Type</label>
            <select class="form-select" asp-for="NewRestaurant.BusinessType" name="BusinessType">
                @foreach (var businessType in Model.BusinessTypeOptions)
                {
                    <option value="@businessType">@businessType</option>
                }
            </select>
        </div>
        <div class="col-12 col-md-6">
            <label class="form-label">WhatsApp Phone Number ID</label>
            <input class="form-control" asp-for="NewRestaurant.WhatsAppPhoneNumberId" name="WhatsAppPhoneNumberId" required />
            <div class="form-text">
                Use Meta's WhatsApp Phone Number ID, not the visible phone number. Incoming webhook messages are routed by this ID.
            </div>
        </div>
        <div class="col-12 col-md-6">
            <label class="form-label">Business Phone</label>
            <input class="form-control" asp-for="NewRestaurant.BusinessPhone" name="BusinessPhone" />
        </div>
        <div class="col-12 col-md-6">
            <label class="form-label">Notification Email</label>
            <input class="form-control" asp-for="NewRestaurant.NotificationEmail" name="NotificationEmail" type="email" />
        </div>
        <div class="col-12 col-md-6">
            <label class="form-label">Staff WhatsApp Number</label>
            <input class="form-control" asp-for="NewRestaurant.StaffWhatsAppNumber" name="StaffWhatsAppNumber" />
        </div>
        <div class="col-12">
            <label class="form-label">Address</label>
            <textarea class="form-control" asp-for="NewRestaurant.Address" name="Address" rows="3"></textarea>
        </div>

        <div class="col-12"><hr /><h3 class="h5">Business owner login</h3></div>
        <div class="col-12 col-md-4">
            <label class="form-label">Owner Name</label>
            <input class="form-control" asp-for="NewRestaurant.OwnerName" name="OwnerName" required />
        </div>
        <div class="col-12 col-md-4">
            <label class="form-label">Owner Email</label>
            <input class="form-control" asp-for="NewRestaurant.OwnerEmail" name="OwnerEmail" type="email" required />
        </div>
        <div class="col-12 col-md-4">
            <label class="form-label">Temporary Password</label>
            <input class="form-control" asp-for="NewRestaurant.OwnerPassword" name="OwnerPassword" type="password" minlength="8" required />
        </div>
        <div class="col-12">
            <div class="form-check">
                <input class="form-check-input" asp-for="NewRestaurant.IsActive" name="IsActive" />
                <label class="form-check-label">Active business</label>
            </div>
        </div>
        <div class="col-12">
            <button class="btn btn-success" type="submit">Create business and owner</button>
        </div>
    </form>
    </div>
</section>
