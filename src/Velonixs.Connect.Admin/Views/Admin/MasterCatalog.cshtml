@model MasterCatalogManageViewModel
@{
    ViewData["Title"] = "Master Catalog";
    var categories = Model.MasterCatalog?.Categories ?? Array.Empty<MasterMenuCategoryResponse>();
    var items = Model.MasterCatalog?.Items ?? Array.Empty<MasterMenuItemResponse>();
}

<section class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-4">
    <div>
        <p class="eyebrow">Admin</p>
        <h1>Master Catalog</h1>
        <p class="text-secondary mb-0">Create common categories and menu items once. Restaurants map these items and set their own price and stock.</p>
    </div>
    <a class="btn btn-outline-success" asp-action="Index">Back to businesses</a>
</section>

<section class="row g-3 mb-4">
    <div class="col-12 col-xl-5">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h4">Add master category</h2>
                <form class="row g-3 align-items-end" asp-action="CreateMasterCategory" method="post">
                    @Html.AntiForgeryToken()
                    <div class="col-12 col-lg-7">
                        <label class="form-label">Category name</label>
                        <input class="form-control" asp-for="NewMasterCategory.Name" name="Name" placeholder="Pizza, Burger, Main Course" required />
                    </div>
                    <div class="col-6 col-lg-2">
                        <label class="form-label">Order</label>
                        <input class="form-control" asp-for="NewMasterCategory.DisplayOrder" name="DisplayOrder" type="number" />
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="form-check mb-lg-2">
                            <input class="form-check-input" asp-for="NewMasterCategory.IsActive" name="IsActive" />
                            <label class="form-check-label">Active</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <button class="btn btn-success" type="submit">Add category</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-7">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h4">Add master menu item</h2>
                @if (categories.Any(x => x.IsActive))
                {
                    <form class="row g-3 align-items-end" asp-action="CreateMasterItem" method="post">
                        @Html.AntiForgeryToken()
                        <div class="col-12 col-lg-4">
                            <label class="form-label">Master category</label>
                            <select class="form-select" asp-for="NewMasterItem.MasterCategoryId" name="MasterCategoryId" required>
                                @foreach (var category in categories.Where(x => x.IsActive))
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-lg-3">
                            <label class="form-label">Item name</label>
                            <input class="form-control" asp-for="NewMasterItem.Name" name="Name" placeholder="Paneer Pizza" required />
                        </div>
                        <div class="col-12 col-lg-3">
                            <label class="form-label">Description</label>
                            <input class="form-control" asp-for="NewMasterItem.Description" name="Description" />
                        </div>
                        <div class="col-6 col-lg-2">
                            <div class="form-check mb-lg-2">
                                <input class="form-check-input" asp-for="NewMasterItem.IsActive" name="IsActive" />
                                <label class="form-check-label">Active</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <button class="btn btn-success" type="submit">Add master item</button>
                        </div>
                    </form>
                }
                else
                {
                    <p class="text-secondary mb-0">Add an active master category first.</p>
                }
            </div>
        </div>
    </div>
</section>

<section class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="section-heading">
            <h2>Master Categories</h2>
        </div>
        <div class="table-responsive stack-mobile">
            <table class="table table-hover align-middle mb-0 responsive-stack">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Order</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var category in categories)
                {
                    <tr>
                        <td colspan="4" class="p-0">
                            <form class="catalog-row" asp-action="UpdateMasterCategory" asp-route-id="@category.Id" method="post">
                                @Html.AntiForgeryToken()
                                <input class="form-control" name="Name" value="@category.Name" required aria-label="Category name" />
                                <input class="form-control" name="DisplayOrder" value="@category.DisplayOrder" type="number" aria-label="Display order" />
                                <label class="form-check mb-0">
                                    <input class="form-check-input" name="IsActive" type="checkbox" value="true" checked="@category.IsActive" />
                                    <input name="IsActive" type="hidden" value="false" />
                                    <span class="form-check-label">Active</span>
                                </label>
                                <div class="d-flex gap-2 justify-content-end">
                                    <button class="btn btn-sm btn-success" type="submit">Save</button>
                                    <button class="btn btn-sm btn-outline-danger" type="submit" formaction="@Url.Action("DeleteMasterCategory", "Admin", new { id = category.Id })">Delete</button>
                                </div>
                            </form>
                        </td>
                    </tr>
                }
                @if (!categories.Any())
                {
                    <tr><td colspan="4" class="text-secondary">No master categories yet.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</section>

<section class="card shadow-sm">
    <div class="card-body">
        <div class="section-heading">
            <h2>Master Menu Items</h2>
        </div>
        <div class="table-responsive stack-mobile">
            <table class="table table-hover align-middle mb-0 responsive-stack">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Menu item</th>
                        <th>Description</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in items)
                {
                    <tr>
                        <td colspan="5" class="p-0">
                            <form class="catalog-item-row" asp-action="UpdateMasterItem" asp-route-id="@item.Id" method="post">
                                @Html.AntiForgeryToken()
                                <select class="form-select" name="MasterCategoryId" required aria-label="Master category">
                                    @foreach (var category in categories)
                                    {
                                        if (category.Id == item.MasterCategoryId)
                                        {
                                            <option value="@category.Id" selected>@category.Name</option>
                                        }
                                        else
                                        {
                                            <option value="@category.Id">@category.Name</option>
                                        }
                                    }
                                </select>
                                <input class="form-control" name="Name" value="@item.Name" required aria-label="Menu item" />
                                <input class="form-control" name="Description" value="@item.Description" aria-label="Description" />
                                <label class="form-check mb-0">
                                    <input class="form-check-input" name="IsActive" type="checkbox" value="true" checked="@item.IsActive" />
                                    <input name="IsActive" type="hidden" value="false" />
                                    <span class="form-check-label">Active</span>
                                </label>
                                <div class="d-flex gap-2 justify-content-end">
                                    <button class="btn btn-sm btn-success" type="submit">Save</button>
                                    <button class="btn btn-sm btn-outline-danger" type="submit" formaction="@Url.Action("DeleteMasterItem", "Admin", new { id = item.Id })">Delete</button>
                                </div>
                            </form>
                        </td>
                    </tr>
                }
                @if (!items.Any())
                {
                    <tr><td colspan="5" class="text-secondary">No master menu items yet.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</section>
