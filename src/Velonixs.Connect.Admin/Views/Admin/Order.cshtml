@model OrderAdminViewModel
@{
    ViewData["Title"] = Model.Order.OrderNumber;
    var isPendingConfirmation = Model.Order.OrderStatus == Velonixs.Connect.Domain.Entities.OrderStatuses.PendingConfirmation;
}

<section class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 mb-4">
    <div>
        <p class="eyebrow">Order</p>
        <h1>@Model.Order.OrderNumber</h1>
    </div>
    @if (Model.Restaurant is not null)
    {
        <a class="btn btn-outline-success" asp-action="Restaurant" asp-route-id="@Model.Restaurant.Id">Back to business</a>
    }
</section>

<section class="row g-3 mb-4">
    <div class="col-12 col-md-4"><div class="metric h-100">
        <span>Status</span>
        <strong>@Model.Order.OrderStatus</strong>
        <small>
            @Model.Order.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
            @if (Model.Order.EstimatedMinutes is int estimatedMinutes)
            {
                <span> - ETA @estimatedMinutes min</span>
            }
        </small>
    </div></div>
    <div class="col-12 col-md-4"><div class="metric h-100">
        <span>Total</span>
        <strong>Rs @Model.Order.TotalAmount.ToString("0.##")</strong>
        <small>@Model.Order.Source</small>
    </div></div>
    <div class="col-12 col-md-4"><div class="metric h-100">
        <span>Customer</span>
        <strong>@Model.Order.CustomerName</strong>
        <small>@Model.Order.CustomerPhone</small>
    </div></div>
</section>

<section class="section-band">
    <div class="section-heading">
        <h2>Order Details</h2>
    </div>

    <div class="row g-3">
        <div class="col-12 col-lg-8"><div class="detail-block h-100">
            <h3>Products</h3>
            @foreach (var item in Model.Order.Items)
            {
                <div class="line-item">
                    <span>@item.Quantity x @item.ItemName</span>
                    <strong>Rs @item.LineTotal.ToString("0.##")</strong>
                </div>
            }
            <div class="line-item total">
                <span>Subtotal</span>
                <strong>Rs @Model.Order.SubTotalAmount.ToString("0.##")</strong>
            </div>
            <div class="line-item">
                <span>CGST (@Model.Order.CgstPercent.ToString("0.##")%)</span>
                <strong>Rs @Model.Order.CgstAmount.ToString("0.##")</strong>
            </div>
            <div class="line-item">
                <span>SGST (@Model.Order.SgstPercent.ToString("0.##")%)</span>
                <strong>Rs @Model.Order.SgstAmount.ToString("0.##")</strong>
            </div>
            <div class="line-item total">
                <span>Total</span>
                <strong>Rs @Model.Order.TotalAmount.ToString("0.##")</strong>
            </div>
        </div></div>

        <form class="col-12 col-lg-4" asp-action="UpdateOrderStatus" asp-route-id="@Model.Order.Id" method="post">
            <div class="panel-form h-100">
            @Html.AntiForgeryToken()
            <h3>Status</h3>
            <label>
                <span>Order status</span>
                <select class="form-select" name="Status">
                    @foreach (var status in Model.StatusOptions)
                    {
                        if (status == Model.Order.OrderStatus)
                        {
                            <option value="@status" selected>@status</option>
                        }
                        else
                        {
                            <option value="@status">@status</option>
                        }
                    }
                </select>
            </label>
            @if (isPendingConfirmation)
            {
                <label>
                    <span>Estimated time for confirmation</span>
                    <select class="form-select" name="EstimatedMinutes">
                        <option value="20">20 minutes</option>
                        <option value="30" selected>30 minutes</option>
                        <option value="45">45 minutes</option>
                    </select>
                </label>
                <label>
                    <span>Custom estimated minutes</span>
                    <input class="form-control" name="CustomEstimatedMinutes" type="number" min="1" max="1440" placeholder="Optional" />
                </label>
            }
            <label>
                <span>Customer-visible comment</span>
                <textarea class="form-control" name="Comment" rows="3" placeholder="Required if rejecting; optional otherwise"></textarea>
            </label>
            <button class="btn btn-success" type="submit">Update status</button>
            </div>
        </form>
    </div>

    <div class="detail-block">
        <h3>Delivery</h3>
        <p>@Model.Order.Address</p>
    </div>
</section>

<section class="section-band">
    <div class="section-heading">
        <h2>Status History</h2>
    </div>
    @if (Model.Order.StatusHistory.Count == 0)
    {
        <p class="text-muted mb-0">No status updates yet.</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Time</th>
                        <th>Change</th>
                        <th>Updated By</th>
                        <th>Comment</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var history in Model.Order.StatusHistory)
                {
                    <tr>
                        <td>@history.UpdatedAtUtc.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</td>
                        <td>@history.PreviousStatus &rarr; @history.NewStatus</td>
                        <td>@history.UpdatedBy</td>
                        <td>@history.Comment</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="section-band">
    <div class="section-heading">
        <h2>Conversation Log</h2>
    </div>
    <div class="message-list">
        @foreach (var message in Model.Order.Messages.OrderByDescending(x => x.CreatedAt).Take(40))
        {
            <article class="message @(message.Direction == "Incoming" ? "incoming" : "outgoing")">
                <div>
                    <strong>@message.Direction</strong>
                    <small>@message.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt") - @message.Status</small>
                </div>
                <p>@message.MessageText</p>
            </article>
        }
    </div>
</section>
