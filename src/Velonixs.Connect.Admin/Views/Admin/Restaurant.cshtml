@model RestaurantManageViewModel
@{
    ViewData["Title"] = Model.Restaurant.Name;
}

<section class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 mb-4">
    <div>
        <p class="eyebrow">@Model.Restaurant.BusinessType</p>
        <h1>@Model.Restaurant.Name</h1>
    </div>
    <a class="btn btn-outline-success" asp-action="Index">All businesses</a>
</section>

<section class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3"><div class="metric h-100">
        <span>Orders</span>
        <strong>@Model.Orders.Count</strong>
        <small>@Model.PendingOrderCount needs attention</small>
    </div></div>
    <div class="col-12 col-sm-6 col-xl-3"><div class="metric h-100">
        <span>Revenue</span>
        <strong>Rs @Model.Revenue.ToString("0.##")</strong>
        <small>All recorded orders</small>
    </div></div>
    <div class="col-12 col-sm-6 col-xl-3"><div class="metric h-100">
        <span>Catalog</span>
        <strong>@Model.ActiveMenuItemCount</strong>
        <small>Available products</small>
    </div></div>
    <div class="col-12 col-sm-6 col-xl-3"><div class="metric h-100">
        <span>Customers</span>
        <strong>@Model.Customers.Count</strong>
        <small>Recent contacts</small>
    </div></div>
</section>

<section class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="section-heading">
            <h2>WhatsApp Messaging Setup</h2>
        </div>
        <div class="row g-3">
            <div class="col-12 col-md-6 col-xl-3">
                <span class="badge @(Model.Restaurant.IsActive ? "text-bg-success" : "text-bg-warning")">
                    @(Model.Restaurant.IsActive ? "Ready" : "Needs attention")
                </span>
                <div class="mt-2 fw-semibold">Business is active</div>
                <small class="text-secondary">Inactive businesses will not receive WhatsApp orders.</small>
            </div>
            <div class="col-12 col-md-6 col-xl-3">
                <span class="badge @(!string.IsNullOrWhiteSpace(Model.Restaurant.WhatsAppPhoneNumberId) ? "text-bg-success" : "text-bg-warning")">
                    @(!string.IsNullOrWhiteSpace(Model.Restaurant.WhatsAppPhoneNumberId) ? "Ready" : "Missing")
                </span>
                <div class="mt-2 fw-semibold">WhatsApp Phone Number ID</div>
                <small class="text-secondary">
                    <code>@(string.IsNullOrWhiteSpace(Model.Restaurant.WhatsAppPhoneNumberId) ? "Not configured" : Model.Restaurant.WhatsAppPhoneNumberId)</code>
                </small>
            </div>
            <div class="col-12 col-md-6 col-xl-3">
                <span class="badge @(Model.ActiveMenuItemCount > 0 ? "text-bg-success" : "text-bg-warning")">
                    @(Model.ActiveMenuItemCount > 0 ? "Ready" : "Add menu")
                </span>
                <div class="mt-2 fw-semibold">Available menu items</div>
                <small class="text-secondary">@Model.ActiveMenuItemCount active and available item(s).</small>
            </div>
            <div class="col-12 col-md-6 col-xl-3">
                <span class="badge @(!string.IsNullOrWhiteSpace(Model.Restaurant.StaffWhatsAppNumber) ? "text-bg-success" : "text-bg-secondary")">
                    @(!string.IsNullOrWhiteSpace(Model.Restaurant.StaffWhatsAppNumber) ? "Configured" : "Optional")
                </span>
                <div class="mt-2 fw-semibold">Staff WhatsApp alerts</div>
                <small class="text-secondary">
                    @(!string.IsNullOrWhiteSpace(Model.Restaurant.StaffWhatsAppNumber)
                        ? Model.Restaurant.StaffWhatsAppNumber
                        : "Add a staff number to receive order alerts.")
                </small>
            </div>
        </div>
    </div>
</section>

<section class="section-band">
    <div class="section-heading">
        <h2>Business Settings</h2>
    </div>

    <form class="form-grid" asp-action="UpdateRestaurant" asp-route-id="@Model.Restaurant.Id" method="post">
        @Html.AntiForgeryToken()
        <label>
            <span>Name</span>
            <input asp-for="RestaurantForm.Name" name="Name" required />
        </label>
        <label>
            <span>Business Type</span>
            <select asp-for="RestaurantForm.BusinessType" name="BusinessType">
                @foreach (var businessType in Model.BusinessTypeOptions)
                {
                    if (businessType == Model.RestaurantForm.BusinessType)
                    {
                        <option value="@businessType" selected>@businessType</option>
                    }
                    else
                    {
                        <option value="@businessType">@businessType</option>
                    }
                }
            </select>
        </label>
        <label>
            <span>WhatsApp Phone Number ID</span>
            <input asp-for="RestaurantForm.WhatsAppPhoneNumberId" name="WhatsAppPhoneNumberId" required />
        </label>
        <label>
            <span>Business Phone</span>
            <input asp-for="RestaurantForm.BusinessPhone" name="BusinessPhone" />
        </label>
        <label>
            <span>Notification Email</span>
            <input asp-for="RestaurantForm.NotificationEmail" name="NotificationEmail" type="email" />
        </label>
        <label>
            <span>Staff WhatsApp Number</span>
            <input asp-for="RestaurantForm.StaffWhatsAppNumber" name="StaffWhatsAppNumber" />
        </label>
        <label class="wide">
            <span>Address</span>
            <textarea asp-for="RestaurantForm.Address" name="Address" rows="3"></textarea>
        </label>
        <label>
            <span>CGST %</span>
            <input asp-for="RestaurantForm.CgstPercent" name="CgstPercent" type="number" min="0" max="100" step="0.01" />
        </label>
        <label>
            <span>SGST %</span>
            <input asp-for="RestaurantForm.SgstPercent" name="SgstPercent" type="number" min="0" max="100" step="0.01" />
        </label>
        <label class="checkline">
            <input asp-for="RestaurantForm.IsActive" name="IsActive" />
            <span>Active</span>
        </label>
        <div class="form-actions">
            <button class="button" type="submit">Save settings</button>
        </div>
    </form>
</section>

<section class="section-band">
    <div class="section-heading">
        <h2>Orders</h2>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Order</th>
                    <th>Customer</th>
                    <th>Status</th>
                    <th>Total</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var order in Model.Orders)
            {
                <tr>
                    <td><strong>@order.OrderNumber</strong><small>@order.Source</small></td>
                    <td>@order.CustomerName<small>@order.CustomerPhone</small></td>
                    <td><span class="pill">@order.OrderStatus</span></td>
                    <td>Rs @order.TotalAmount.ToString("0.##")</td>
                    <td>@order.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</td>
                    <td class="text-end"><a class="btn btn-sm btn-success" asp-action="Order" asp-route-id="@order.Id">Open</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>

<section class="section-band">
    <div class="section-heading">
        <h2>Catalog</h2>
    </div>

    <div class="split-grid">
        <form class="panel-form" asp-action="CreateCategory" asp-route-restaurantId="@Model.Restaurant.Id" method="post">
            @Html.AntiForgeryToken()
            <h3>Add Category</h3>
            <label>
                <span>Name</span>
                <input asp-for="NewCategory.Name" name="Name" required />
            </label>
            <label>
                <span>Display Order</span>
                <input asp-for="NewCategory.DisplayOrder" name="DisplayOrder" type="number" />
            </label>
            <label class="checkline">
                <input asp-for="NewCategory.IsActive" name="IsActive" />
                <span>Active</span>
            </label>
            <button class="button" type="submit">Add category</button>
        </form>

        <form class="panel-form" asp-action="CreateItem" asp-route-restaurantId="@Model.Restaurant.Id" method="post">
            @Html.AntiForgeryToken()
            <h3>Add Product</h3>
            <label>
                <span>Category</span>
                <select asp-for="NewItem.CategoryId" name="CategoryId" required>
                    @foreach (var category in Model.Menu?.Categories ?? Array.Empty<MenuCategoryResponse>())
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                </select>
            </label>
            <label>
                <span>Product Code</span>
                <input asp-for="NewItem.ItemCode" name="ItemCode" type="number" required />
            </label>
            <label>
                <span>Product Name</span>
                <input asp-for="NewItem.Name" name="Name" required />
            </label>
            <label>
                <span>Price</span>
                <input asp-for="NewItem.Price" name="Price" type="number" step="0.01" min="0" required />
            </label>
            <label class="wide">
                <span>Description</span>
                <textarea asp-for="NewItem.Description" name="Description" rows="2"></textarea>
            </label>
            <label class="checkline">
                <input asp-for="NewItem.IsAvailable" name="IsAvailable" />
                <span>Available</span>
            </label>
            <label class="checkline">
                <input asp-for="NewItem.IsActive" name="IsActive" />
                <span>Active</span>
            </label>
            <button class="button" type="submit">Add product</button>
        </form>
    </div>

    <div class="menu-list">
        @foreach (var item in (Model.Menu?.Items ?? Array.Empty<MenuItemResponse>()).OrderBy(x => x.ItemCode))
        {
            <form class="menu-row" asp-action="UpdateItem" asp-route-restaurantId="@Model.Restaurant.Id" asp-route-id="@item.Id" method="post">
                @Html.AntiForgeryToken()
                <input name="ItemCode" value="@item.ItemCode" type="number" aria-label="Item code" />
                <select name="CategoryId" aria-label="Category">
                    @foreach (var category in Model.Menu?.Categories ?? Array.Empty<MenuCategoryResponse>())
                    {
                        if (category.Id == item.CategoryId)
                        {
                            <option value="@category.Id" selected>@category.Name</option>
                        }
                        else
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    }
                </select>
                <input name="Name" value="@item.Name" aria-label="Item name" />
                <input name="Price" value="@item.Price.ToString("0.##")" type="number" step="0.01" min="0" aria-label="Price" />
                <input name="Description" value="@item.Description" aria-label="Description" />
                <label class="checkline">
                    <input name="IsAvailable" type="checkbox" value="true" checked="@item.IsAvailable" />
                    <input name="IsAvailable" type="hidden" value="false" />
                    <span>Available</span>
                </label>
                <label class="checkline">
                    <input name="IsActive" type="checkbox" value="true" checked="@item.IsActive" />
                    <input name="IsActive" type="hidden" value="false" />
                    <span>Active</span>
                </label>
                <button class="button compact" type="submit">Save</button>
                <button class="button compact danger" type="submit" formaction="@Url.Action("DeactivateItem", "Admin", new { restaurantId = Model.Restaurant.Id, id = item.Id })">Deactivate</button>
            </form>
        }
    </div>
</section>

<section class="section-band">
    <div class="section-heading">
        <h2>Customers</h2>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Customer</th>
                    <th>Phone</th>
                    <th>Orders</th>
                    <th>Last Address</th>
                    <th>Last Active</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var customer in Model.Customers)
            {
                <tr>
                    <td>@(customer.Name ?? "WhatsApp Customer")</td>
                    <td>@customer.PhoneNumber</td>
                    <td>@customer.OrderCount</td>
                    <td>@customer.LastAddress</td>
                    <td>@customer.LastInteractionAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>

<section class="section-band">
    <div class="section-heading">
        <h2>Portal Users</h2>
    </div>
    @if (!Model.Users.Any(user => user.Role == Velonixs.Connect.Shared.Security.AppRoles.BusinessOwner))
    {
        <form class="row g-3 mb-4" asp-action="CreateOwner" asp-route-id="@Model.Restaurant.Id" method="post">
            @Html.AntiForgeryToken()
            <div class="col-12"><p class="text-secondary mb-0">This business has no owner login yet.</p></div>
            <div class="col-12 col-md-4">
                <label class="form-label">Owner Name</label>
                <input class="form-control" asp-for="NewOwner.DisplayName" name="DisplayName" required />
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label">Owner Email</label>
                <input class="form-control" asp-for="NewOwner.Email" name="Email" type="email" required />
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label">Temporary Password</label>
                <input class="form-control" asp-for="NewOwner.Password" name="Password" type="password" minlength="8" required />
            </div>
            <div class="col-12">
                <button class="btn btn-success" type="submit">Create owner login</button>
            </div>
        </form>
    }
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Reset Password</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var user in Model.Users)
            {
                <tr>
                    <td>@user.DisplayName</td>
                    <td>@user.Email</td>
                    <td><span class="badge text-bg-light border">@user.Role</span></td>
                    <td><span class="badge @(user.IsActive ? "text-bg-success" : "text-bg-secondary")">@(user.IsActive ? "Active" : "Inactive")</span></td>
                    <td>
                        <form class="d-flex flex-column flex-lg-row gap-2"
                              asp-action="ResetPortalUserPassword"
                              asp-route-restaurantId="@Model.Restaurant.Id"
                              asp-route-userId="@user.Id"
                              method="post">
                            @Html.AntiForgeryToken()
                            <input class="form-control form-control-sm"
                                   name="NewPassword"
                                   type="password"
                                   minlength="8"
                                   autocomplete="new-password"
                                   placeholder="New temporary password"
                                   required />
                            <button class="btn btn-sm btn-outline-warning" type="submit">Reset</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
