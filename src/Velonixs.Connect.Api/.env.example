# Example environment variables for Meta Catalog creation
# Do NOT commit real secrets. Use local user secrets or environment variables in production.

# Long-lived access token with required permissions (business_management, catalogs_manage)
META_CATALOG_ACCESS_TOKEN=your_long_lived_access_token_here

# The Meta Business Manager ID (numeric)
META_CATALOG_BUSINESS_ID=123456789012345

# Optional: override graph API version
META_CATALOG_GRAPH_API_VERSION=v26.0
