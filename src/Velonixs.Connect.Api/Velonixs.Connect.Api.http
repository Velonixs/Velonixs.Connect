@Velonixs.Connect.Api_HostAddress = http://localhost:5077
@BusinessId = replace-with-id-from-get-businesses
@RestaurantId = {{BusinessId}}
@PhoneNumberId = 1196816620181240
@AccessToken = paste-access-token-from-login-response

GET {{Velonixs.Connect.Api_HostAddress}}/health
Accept: application/json

###

POST {{Velonixs.Connect.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "your-user@example.com",
  "password": "your-password"
}

###

GET {{Velonixs.Connect.Api_HostAddress}}/api/businesses
Accept: application/json
Authorization: Bearer {{AccessToken}}

###

GET {{Velonixs.Connect.Api_HostAddress}}/api/businesses/{{BusinessId}}/catalog
Accept: application/json
Authorization: Bearer {{AccessToken}}

###

GET {{Velonixs.Connect.Api_HostAddress}}/api/businesses/{{BusinessId}}/orders
Accept: application/json
Authorization: Bearer {{AccessToken}}

###

GET {{Velonixs.Connect.Api_HostAddress}}/api/restaurants/{{RestaurantId}}/menu
Accept: application/json
Authorization: Bearer {{AccessToken}}

###

GET {{Velonixs.Connect.Api_HostAddress}}/api/webhooks/whatsapp?hub.mode=subscribe&hub.verify_token=local-verify-token&hub.challenge=challenge-ok

###

POST {{Velonixs.Connect.Api_HostAddress}}/api/webhooks/whatsapp/local-test
Content-Type: application/json

{
  "messageText": "Hi",
  "phoneNumberId": "{{PhoneNumberId}}",
  "fromPhoneNumber": "+919876543210"
}

###

POST {{Velonixs.Connect.Api_HostAddress}}/api/webhooks/whatsapp/local-test
Content-Type: application/json

{
  "messageText": "Order: 1 x 2, 4 x 1",
  "phoneNumberId": "{{PhoneNumberId}}",
  "fromPhoneNumber": "+919876543210"
}

###

POST {{Velonixs.Connect.Api_HostAddress}}/api/webhooks/whatsapp/local-test
Content-Type: application/json

{
  "messageText": "checkout",
  "phoneNumberId": "{{PhoneNumberId}}",
  "fromPhoneNumber": "+919876543210"
}

###

POST {{Velonixs.Connect.Api_HostAddress}}/api/webhooks/whatsapp/local-test
Content-Type: application/json

{
  "messageText": "Rajesh",
  "phoneNumberId": "{{PhoneNumberId}}",
  "fromPhoneNumber": "+919876543210"
}

###

POST {{Velonixs.Connect.Api_HostAddress}}/api/webhooks/whatsapp/local-test
Content-Type: application/json

{
  "messageText": "checkout.delivery",
  "phoneNumberId": "{{PhoneNumberId}}",
  "fromPhoneNumber": "+919876543210"
}

###

POST {{Velonixs.Connect.Api_HostAddress}}/api/webhooks/whatsapp/local-test
Content-Type: application/json

{
  "messageText": "Near Station Road, Jamtara",
  "phoneNumberId": "{{PhoneNumberId}}",
  "fromPhoneNumber": "+919876543210"
}

###

POST {{Velonixs.Connect.Api_HostAddress}}/api/webhooks/whatsapp/local-test
Content-Type: application/json

{
  "messageText": "YES",
  "phoneNumberId": "{{PhoneNumberId}}",
  "fromPhoneNumber": "+919876543210"
}

###

GET {{Velonixs.Connect.Api_HostAddress}}/api/restaurants/{{RestaurantId}}/orders
Accept: application/json

###
