@inherits LayoutComponentBase
@inject IVelonixsConnectApiClient ApiClient
@inject IApiTokenStore TokenStore
@inject IOrderRealtimeClient RealtimeClient
@inject NavigationManager Navigation
@implements IDisposable

<nav class="navbar navbar-expand-xl bg-white border-bottom sticky-top app-navbar">
    <div class="container-fluid px-3 px-xl-4">
        <NavLink class="navbar-brand brand" href="" Match="NavLinkMatch.All">
            <span class="brand-mark"><img src="images/logo.png" alt="Velonixs Connect" /></span>
            <span class="brand-copy"><strong>Business Portal</strong><small>Velonixs Connect</small></span>
        </NavLink>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#portalNavigation" aria-controls="portalNavigation" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="portalNavigation">
            @if (!IsLoginRoute())
            {
                <div class="portal-nav-bar">
                    <ul class="navbar-nav portal-main-nav">
                    <li class="nav-item"><NavLink class="nav-link" href="" Match="NavLinkMatch.All">Dashboard</NavLink></li>
                    <li class="nav-item"><NavLink class="nav-link" href="orders">Orders</NavLink></li>
                    <li class="nav-item"><NavLink class="nav-link" href="menu">Menu</NavLink></li>
                    <li class="nav-item"><NavLink class="nav-link" href="customers">Customers</NavLink></li>
                    <li class="nav-item"><NavLink class="nav-link" href="staff">Staff Users</NavLink></li>
                    <li class="nav-item"><NavLink class="nav-link" href="notifications">Messages</NavLink></li>
                    <li class="nav-item"><NavLink class="nav-link" href="settings">Settings</NavLink></li>
                    </ul>
                    <div class="portal-nav-actions">
                        <span class="nav-status realtime-state @RealtimeStateClass">@RealtimeStateLabel</span>
                        <button type="button" class="btn btn-outline-secondary sign-out-button" @onclick="LogoutAsync">Sign out</button>
                    </div>
                </div>
            }
        </div>
    </div>
</nav>

<main class="container-fluid page-shell px-3 px-lg-4 py-4">
    @Body
</main>

@code {
    private bool realtimeStarted;
    private OrderRealtimeConnectionState realtimeState;

    private string RealtimeStateLabel =>
        realtimeState switch
        {
            OrderRealtimeConnectionState.Connected => "Live",
            OrderRealtimeConnectionState.Connecting => "Connecting",
            OrderRealtimeConnectionState.Reconnecting => "Reconnecting",
            _ => "Offline"
        };

    private string RealtimeStateClass =>
        realtimeState == OrderRealtimeConnectionState.Connected ? "is-live" : "is-muted";

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        RealtimeClient.ConnectionStateChanged += OnRealtimeStateChanged;
        await SyncRealtimeStateAsync();
    }

    private async Task SyncRealtimeStateAsync()
    {
        if (!IsLoginRoute() && await TokenStore.GetAsync() is null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (IsLoginRoute())
        {
            if (realtimeStarted)
            {
                await RealtimeClient.StopAsync();
                realtimeStarted = false;
            }

            return;
        }

        if (!realtimeStarted)
        {
            await RealtimeClient.StartAsync();
            realtimeStarted = true;
        }
    }

    private async Task LogoutAsync()
    {
        await RealtimeClient.StopAsync();
        realtimeStarted = false;
        await ApiClient.LogoutAsync();
        Navigation.NavigateTo("/login", forceLoad: false);
    }

    private bool IsLoginRoute()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        return relative.StartsWith("login", StringComparison.OrdinalIgnoreCase);
    }

    private void OnRealtimeStateChanged(object? sender, OrderRealtimeConnectionState state)
    {
        realtimeState = state;
        _ = InvokeAsync(StateHasChanged);
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        await SyncRealtimeStateAsync();
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        RealtimeClient.ConnectionStateChanged -= OnRealtimeStateChanged;
    }
}
