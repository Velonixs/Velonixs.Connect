@page "/orders/{OrderId:guid}"
@using Velonixs.Connect.Contracts.Orders
@inject IVelonixsConnectApiClient ApiClient
@inject IOrderRealtimeClient RealtimeClient
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Order Detail</PageTitle>

<section class="page-heading">
    <div>
        <p class="eyebrow">Restaurant portal</p>
        <h1>@(order?.OrderNumber ?? "Order")</h1>
    </div>
    <button class="secondary-button" type="button" @onclick="LoadAsync">Refresh</button>
</section>

<ApiErrorAlert Error="error" Title="Order unavailable" />
<LoadingPanel IsLoading="isLoading" Message="Loading order" />

@if (order is not null)
{
    <section class="metric-grid">
        <MetricTile Label="Status" Value="@order.OrderStatus" Detail="Current state" />
        <MetricTile Label="Total" Value="@order.TotalAmount.ToString("C0")" Detail="Including taxes" />
        <MetricTile Label="ETA" Value="@(order.EstimatedMinutes?.ToString() ?? "-")" Detail="Minutes" />
        <MetricTile Label="Items" Value="@order.Items.Count.ToString()" Detail="Line items" />
    </section>

    <section class="data-grid">
        <div class="data-section">
            <div class="section-heading">
                <h2>Items</h2>
                <OrderStatusBadge Status="@order.OrderStatus" />
            </div>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th>Qty</th>
                            <th>Price</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in order.Items)
                        {
                            <tr>
                                <td>@item.ItemName</td>
                                <td>@item.Quantity</td>
                                <td>@item.UnitPrice.ToString("C0")</td>
                                <td>@item.LineTotal.ToString("C0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (CanConfirm(order))
            {
                <div class="action-strip">
                    <button class="primary-button" type="button" @onclick="ConfirmAsync">Confirm order</button>
                    <button class="secondary-button danger" type="button" @onclick="RejectAsync">Reject order</button>
                </div>
            }
        </div>

        <div class="data-section">
            <div class="section-heading">
                <h2>Customer</h2>
            </div>
            <div class="detail-list">
                <div><span>Name</span><strong>@order.CustomerName</strong></div>
                <div><span>Phone</span><strong>@order.CustomerPhone</strong></div>
                <div><span>Address</span><strong>@order.Address</strong></div>
                <div><span>Source</span><strong>@order.Source</strong></div>
            </div>
        </div>
    </section>

    <section class="data-grid">
        <div class="data-section">
            <div class="section-heading">
                <h2>Status history</h2>
                <span>@order.StatusHistory.Count entries</span>
            </div>
            <div class="compact-list">
                @foreach (var history in order.StatusHistory.OrderByDescending(x => x.UpdatedAtUtc))
                {
                    <div>
                        <strong>@history.NewStatus</strong>
                        <span>@history.UpdatedAtUtc.ToLocalTime().ToString("dd MMM, HH:mm")</span>
                    </div>
                }
            </div>
        </div>

        <div class="data-section">
            <div class="section-heading">
                <h2>Messages</h2>
                <span>@order.Messages.Count entries</span>
            </div>
            <div class="notification-list">
                @foreach (var message in order.Messages.OrderByDescending(x => x.CreatedAt))
                {
                    <article>
                        <div class="notification-meta">
                            <strong>@message.Direction</strong>
                            <span>@message.CreatedAt.ToLocalTime().ToString("dd MMM, HH:mm")</span>
                            <span>@message.Status</span>
                        </div>
                        <p>@message.MessageText</p>
                    </article>
                }
            </div>
        </div>
    </section>
}

@code {
    [Parameter] public Guid OrderId { get; set; }

    private OrderDetailResponse? order;
    private bool isLoading;
    private ApiClientException? error;

    protected override Task OnInitializedAsync()
    {
        RealtimeClient.OrderChanged += OnOrderChanged;
        return Task.CompletedTask;
    }

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        error = null;

        try
        {
            order = await ApiClient.GetOrderAsync(OrderId);
        }
        catch (ApiClientException exception)
        {
            error = exception;
            RedirectIfUnauthorized(exception);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ConfirmAsync()
    {
        error = null;

        try
        {
            order = await ApiClient.ConfirmOrderAsync(OrderId, new ConfirmOrderRequest(30, "Order confirmed."));
        }
        catch (ApiClientException exception)
        {
            error = exception;
            RedirectIfUnauthorized(exception);
        }
    }

    private async Task RejectAsync()
    {
        error = null;

        try
        {
            order = await ApiClient.RejectOrderAsync(OrderId, new RejectOrderRequest("Rejected from portal."));
        }
        catch (ApiClientException exception)
        {
            error = exception;
            RedirectIfUnauthorized(exception);
        }
    }

    private static bool CanConfirm(OrderDetailResponse order) =>
        string.Equals(order.OrderStatus, "pending_confirmation", StringComparison.OrdinalIgnoreCase);

    private void RedirectIfUnauthorized(ApiClientException exception)
    {
        if ((int)exception.StatusCode == 401)
        {
            Navigation.NavigateTo("/login");
        }
    }

    private async void OnOrderChanged(object? sender, OrderRealtimeEvent orderEvent)
    {
        if (orderEvent.OrderId == OrderId)
        {
            await InvokeAsync(LoadAsync);
        }
    }

    public void Dispose()
    {
        RealtimeClient.OrderChanged -= OnOrderChanged;
    }
}
