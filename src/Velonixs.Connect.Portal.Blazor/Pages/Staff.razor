@page "/staff"
@using System.ComponentModel.DataAnnotations
@inject IVelonixsConnectApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Staff</PageTitle>

<section class="page-heading">
    <div>
        <p class="eyebrow">Restaurant portal</p>
        <h1>Staff</h1>
    </div>
    <button class="secondary-button" type="button" @onclick="LoadAsync">Refresh</button>
</section>

<ApiErrorAlert Error="error" Title="Staff unavailable" />
<LoadingPanel IsLoading="isLoading" Message="Loading staff" />

<section class="data-grid">
    <div class="data-section">
        <div class="section-heading">
            <h2>Staff accounts</h2>
            <span>@staff.Count entries</span>
        </div>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in staff.OrderBy(x => x.DisplayName))
                    {
                        <tr>
                            <td>@user.DisplayName</td>
                            <td>@user.Email</td>
                            <td>@user.Role</td>
                            <td>@(user.IsActive ? "Active" : "Inactive")</td>
                            <td>
                                <button class="small-action" type="button" @onclick="() => ToggleStatusAsync(user)">
                                    @(user.IsActive ? "Deactivate" : "Activate")
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="data-section">
        <div class="section-heading">
            <h2>Create staff</h2>
        </div>
        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="success-alert">@successMessage</div>
        }
        <EditForm Model="form" OnValidSubmit="CreateAsync" class="form-stack">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <label>
                <span>Name</span>
                <InputText @bind-Value="form.DisplayName" />
            </label>
            <label>
                <span>Email</span>
                <InputText @bind-Value="form.Email" type="email" />
            </label>
            <label>
                <span>Temporary password</span>
                <InputText @bind-Value="form.Password" type="password" />
            </label>
            <label>
                <span>Role</span>
                <InputSelect @bind-Value="form.Role">
                    <option value="BusinessManager">Business manager</option>
                    <option value="Cashier">Cashier</option>
                    <option value="Staff">Staff</option>
                </InputSelect>
            </label>
            <button class="primary-button" type="submit" disabled="@isSubmitting">
                @(isSubmitting ? "Creating" : "Create staff")
            </button>
        </EditForm>
    </div>
</section>

@code {
    private IReadOnlyCollection<StaffUserResponse> staff = Array.Empty<StaffUserResponse>();
    private readonly StaffForm form = new();
    private bool isLoading;
    private bool isSubmitting;
    private string? successMessage;
    private ApiClientException? error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        error = null;

        try
        {
            staff = await ApiClient.GetStaffAsync();
        }
        catch (ApiClientException exception)
        {
            error = exception;
            RedirectIfUnauthorized(exception);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CreateAsync()
    {
        isSubmitting = true;
        error = null;
        successMessage = null;

        try
        {
            var created = await ApiClient.CreateStaffAsync(
                restaurantId: null,
                new CreateStaffUserRequest(form.DisplayName, form.Email, form.Password, form.Role));
            successMessage = $"Created {created.Email}.";
            form.Reset();
            await LoadAsync();
        }
        catch (ApiClientException exception)
        {
            error = exception;
            RedirectIfUnauthorized(exception);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task ToggleStatusAsync(StaffUserResponse user)
    {
        error = null;

        try
        {
            await ApiClient.UpdateStaffStatusAsync(
                user.Id,
                restaurantId: null,
                new UpdateStaffStatusRequest(!user.IsActive));
            await LoadAsync();
        }
        catch (ApiClientException exception)
        {
            error = exception;
            RedirectIfUnauthorized(exception);
        }
    }

    private void RedirectIfUnauthorized(ApiClientException exception)
    {
        if ((int)exception.StatusCode == 401)
        {
            Navigation.NavigateTo("/login");
        }
    }

    private sealed class StaffForm
    {
        [Required]
        public string DisplayName { get; set; } = string.Empty;

        [Required]
        [EmailAddress]
        public string Email { get; set; } = string.Empty;

        [Required]
        [MinLength(8)]
        public string Password { get; set; } = string.Empty;

        [Required]
        public string Role { get; set; } = "Staff";

        public void Reset()
        {
            DisplayName = string.Empty;
            Email = string.Empty;
            Password = string.Empty;
            Role = "Staff";
        }
    }
}
