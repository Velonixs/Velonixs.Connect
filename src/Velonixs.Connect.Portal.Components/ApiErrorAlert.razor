@using Velonixs.Connect.Api.Client

@if (Error is not null)
{
    <div class="alert alert-danger" role="alert">
        <div>
            <strong>@Title</strong>
            <p class="mb-0">@Error.Message</p>
        </div>
        @if (!string.IsNullOrWhiteSpace(Error.Error?.TraceId))
        {
            <small>Trace @Error.Error.TraceId</small>
        }
    </div>
}

@code {
    [Parameter] public ApiClientException? Error { get; set; }
    [Parameter] public string Title { get; set; } = "Request failed";
}
