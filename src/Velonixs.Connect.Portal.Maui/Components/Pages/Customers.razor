@page "/customers"
@using System.ComponentModel.DataAnnotations
@inject IVelonixsConnectApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Customers</PageTitle>

<section class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-4">
    <div>
        <p class="eyebrow">@restaurantName</p>
        <h1>Customers</h1>
        <p class="text-secondary mb-0">Review customer records and update saved delivery details when needed.</p>
    </div>
    <div class="d-flex flex-wrap gap-2 justify-content-lg-end ms-lg-auto">
        <a class="btn btn-outline-primary" href="/">Back to dashboard</a>
        <button class="btn btn-outline-secondary" type="button" @onclick="LoadAsync">Refresh</button>
    </div>
</section>

<ApiErrorAlert Error="error" Title="Customers unavailable" />
<LoadingPanel IsLoading="isLoading" Message="Loading customers" />

<section class="card shadow-sm">
    <div class="card-body">
        <div class="section-heading">
            <h2>Recent Customers</h2>
        </div>
        <div class="table-responsive stack-mobile">
            <table class="table table-hover align-middle mb-0 responsive-stack">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>Last Address</th>
                        <th>Last Active</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customer in customers.OrderByDescending(x => x.LastInteractionAt))
                    {
                        var edit = GetEdit(customer);
                        <tr>
                            <td colspan="5" class="p-0">
                                <EditForm Model="edit" OnValidSubmit="() => SaveAsync(customer.Id)" class="customer-row">
                                    <DataAnnotationsValidator />
                                    <InputText class="form-control" @bind-Value="edit.Name" placeholder="Customer name" aria-label="Customer name" />
                                    <span class="fw-semibold">@customer.PhoneNumber</span>
                                    <InputText class="form-control" @bind-Value="edit.LastAddress" placeholder="Last address" aria-label="Last address" />
                                    <span>@customer.LastInteractionAt.ToLocalTime().ToString("dd MMM, hh:mm tt")</span>
                                    <div class="text-end">
                                        <button class="btn btn-sm btn-primary" type="submit" disabled="@isSubmitting">Save</button>
                                    </div>
                                </EditForm>
                            </td>
                        </tr>
                    }
                    @if (!customers.Any())
                    {
                        <tr><td colspan="5" class="text-secondary">No customers yet.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

@code {
    private readonly Dictionary<Guid, CustomerEditForm> edits = [];
    private IReadOnlyCollection<CustomerSummaryResponse> customers = Array.Empty<CustomerSummaryResponse>();
    private string restaurantName = "Restaurant";
    private bool isLoading;
    private bool isSubmitting;
    private ApiClientException? error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        error = null;

        try
        {
            var dashboard = await ApiClient.GetRestaurantDashboardAsync();
            restaurantName = dashboard.Restaurant.Name;
            customers = await ApiClient.GetCustomersAsync(take: 200);
            edits.Clear();
            foreach (var customer in customers)
            {
                edits[customer.Id] = CustomerEditForm.From(customer);
            }
        }
        catch (ApiClientException exception)
        {
            error = exception;
            RedirectIfUnauthorized(exception);
        }
        finally
        {
            isLoading = false;
        }
    }

    private CustomerEditForm GetEdit(CustomerSummaryResponse customer)
    {
        if (!edits.TryGetValue(customer.Id, out var edit))
        {
            edit = CustomerEditForm.From(customer);
            edits[customer.Id] = edit;
        }

        return edit;
    }

    private async Task SaveAsync(Guid customerId)
    {
        if (!edits.TryGetValue(customerId, out var edit))
        {
            return;
        }

        isSubmitting = true;
        error = null;

        try
        {
            await ApiClient.UpdateCustomerAsync(customerId, new UpdateCustomerRequest(edit.Name, edit.LastAddress));
            await LoadAsync();
        }
        catch (ApiClientException exception)
        {
            error = exception;
            RedirectIfUnauthorized(exception);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void RedirectIfUnauthorized(ApiClientException exception)
    {
        if ((int)exception.StatusCode == 401)
        {
            Navigation.NavigateTo("/login");
        }
    }

    private sealed class CustomerEditForm
    {
        [StringLength(120)]
        public string? Name { get; set; }

        [StringLength(500)]
        public string? LastAddress { get; set; }

        public static CustomerEditForm From(CustomerSummaryResponse customer) => new()
        {
            Name = customer.Name,
            LastAddress = customer.LastAddress
        };
    }
}
