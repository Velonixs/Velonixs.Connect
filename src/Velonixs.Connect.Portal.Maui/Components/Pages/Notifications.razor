@page "/notifications"
@using System.Text.RegularExpressions
@inject IVelonixsConnectApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Notifications</PageTitle>

<section class="page-heading">
    <div>
        <p class="eyebrow">Restaurant portal</p>
        <h1>Messages</h1>
    </div>
    <button class="secondary-button" type="button" @onclick="LoadAsync">Refresh</button>
</section>

<ApiErrorAlert Error="error" Title="Notifications unavailable" />
<LoadingPanel IsLoading="isLoading" Message="Loading notifications" />

<section class="data-section">
    <div class="section-heading">
        <h2>Recent messages</h2>
        <span>@notifications.Count entries</span>
    </div>

    @if (notifications.Count == 0)
    {
        <div class="empty-state">No notification messages have been logged yet.</div>
    }
    else
    {
        <div class="notification-list">
            @foreach (var notification in notifications.OrderByDescending(x => x.CreatedAt))
            {
                <article class="notification-tile @DirectionClass(notification.Direction)">
                    <div class="notification-tile-header">
                        <div>
                            <span class="notification-direction">@notification.Direction</span>
                            <strong>@notification.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</strong>
                        </div>
                        <span class="notification-status @StatusClass(notification.Status)">@notification.Status</span>
                    </div>

                    <div class="notification-body">
                        @foreach (var line in FormatMessageLines(notification.MessageText))
                        {
                            <p>@line</p>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(notification.WhatsAppMessageId))
                    {
                        <div class="notification-id">
                            <span>WhatsApp ID</span>
                            <code>@notification.WhatsAppMessageId</code>
                        </div>
                    }
                </article>
            }
        </div>
    }
</section>

@code {
    private IReadOnlyCollection<NotificationLogResponse> notifications = Array.Empty<NotificationLogResponse>();
    private bool isLoading;
    private ApiClientException? error;

    private static IReadOnlyList<string> FormatMessageLines(string messageText)
    {
        if (string.IsNullOrWhiteSpace(messageText))
        {
            return ["No message content"];
        }

        var normalized = messageText
            .Replace("*", string.Empty)
            .Replace("\r", " ")
            .Replace("\n", " ");

        normalized = Regex.Replace(normalized, @"\s+", " ").Trim();
        normalized = Regex.Replace(normalized, @"\s+(?=\d+\.\s)", "\n");
        normalized = Regex.Replace(normalized, @"\s+(?=(Reply with|To place order|Please choose|Order:)\b)", "\n", RegexOptions.IgnoreCase);

        return normalized
            .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .DefaultIfEmpty("No message content")
            .ToArray();
    }

    private static string DirectionClass(string direction) =>
        string.Equals(direction, "Incoming", StringComparison.OrdinalIgnoreCase) ? "is-incoming" : "is-outgoing";

    private static string StatusClass(string status) =>
        status.ToLowerInvariant() switch
        {
            "sent" or "delivered" or "received" => "is-ok",
            "failed" or "error" => "is-error",
            _ => "is-neutral"
        };

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        error = null;

        try
        {
            notifications = await ApiClient.GetNotificationsAsync(take: 100);
        }
        catch (ApiClientException exception)
        {
            error = exception;
            RedirectIfUnauthorized(exception);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void RedirectIfUnauthorized(ApiClientException exception)
    {
        if ((int)exception.StatusCode == 401)
        {
            Navigation.NavigateTo("/login");
        }
    }
}
