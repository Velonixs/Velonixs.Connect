@page "/orders"
@using System.ComponentModel.DataAnnotations
@using Velonixs.Connect.Contracts.Orders
@inject IVelonixsConnectApiClient ApiClient
@inject IOrderRealtimeClient RealtimeClient
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Orders</PageTitle>

<section class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-4">
    <div>
        <p class="eyebrow">Restaurant Portal</p>
        <h1>Orders</h1>
        <p class="text-secondary mb-0">Review live WhatsApp orders and confirm or reject pending requests.</p>
    </div>
    <div class="d-flex flex-wrap gap-2 justify-content-lg-end ms-lg-auto">
        <a class="btn btn-outline-primary" href="/">Back to dashboard</a>
        <button class="btn btn-outline-secondary" type="button" @onclick="LoadAsync">Refresh</button>
    </div>
</section>

<ApiErrorAlert Error="error" Title="Orders unavailable" />
<LoadingPanel IsLoading="isLoading" Message="Loading orders" />

<section class="card shadow-sm">
    <div class="card-body">
    <div class="section-heading">
        <h2>Order queue</h2>
    </div>

    <div class="table-responsive stack-mobile">
        <table class="table table-hover align-middle mb-0 responsive-stack">
            <thead>
                <tr>
                    <th>Order</th>
                    <th>Customer</th>
                    <th>Status</th>
                    <th>Total</th>
                    <th>ETA</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in orders.OrderByDescending(x => x.CreatedAt))
                {
                    <tr>
                        <td data-label="Order"><a class="inline-link" href="@($"orders/{order.Id}")">@order.OrderNumber</a><small>@order.Address</small></td>
                        <td data-label="Customer">
                            <strong>@order.CustomerName</strong>
                            <span class="subtle-cell">@order.CustomerPhone</span>
                        </td>
                        <td data-label="Status"><OrderStatusBadge Status="@order.OrderStatus" /></td>
                        <td data-label="Total">Rs @order.TotalAmount.ToString("0.##")</td>
                        <td data-label="ETA">@(order.EstimatedMinutes is null ? "-" : $"{order.EstimatedMinutes} min")</td>
                        <td data-label="">
                            @if (CanConfirm(order))
                            {
                                <button class="btn btn-sm btn-primary" type="button" @onclick="() => ConfirmAsync(order.Id)">Confirm</button>
                                <button class="btn btn-sm btn-outline-danger" type="button" @onclick="() => BeginReject(order)">Reject</button>
                            }
                            else
                            {
                                <span class="subtle-cell">No action</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    </div>
</section>

@if (rejectingOrder is not null)
{
    <section class="card shadow-sm mt-4 action-panel">
        <div class="card-body">
        <div class="section-heading">
            <h2>Reject @rejectingOrder.OrderNumber</h2>
            <button class="btn btn-outline-secondary" type="button" @onclick="CancelReject">Cancel</button>
        </div>
        <EditForm Model="rejectForm" OnValidSubmit="RejectAsync" class="row g-3">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="col-12">
                <label class="form-label">Reason</label>
                <InputTextArea class="form-control" @bind-Value="rejectForm.Reason" />
            </div>
            <div class="col-12">
                <button class="btn btn-outline-danger" type="submit" disabled="@isSubmitting">
                    @(isSubmitting ? "Rejecting" : "Reject order")
                </button>
            </div>
        </EditForm>
        </div>
    </section>
}

@code {
    private IReadOnlyCollection<OrderSummaryResponse> orders = Array.Empty<OrderSummaryResponse>();
    private readonly RejectForm rejectForm = new();
    private OrderSummaryResponse? rejectingOrder;
    private bool isLoading;
    private bool isSubmitting;
    private ApiClientException? error;

    protected override Task OnInitializedAsync()
    {
        RealtimeClient.OrderChanged += OnOrderChanged;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        error = null;

        try
        {
            orders = await ApiClient.GetOrdersAsync();
        }
        catch (ApiClientException exception)
        {
            error = exception;
            RedirectIfUnauthorized(exception);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ConfirmAsync(Guid orderId)
    {
        isSubmitting = true;
        error = null;

        try
        {
            await ApiClient.ConfirmOrderAsync(orderId, new ConfirmOrderRequest(30, "Order confirmed."));
            await LoadAsync();
        }
        catch (ApiClientException exception)
        {
            error = exception;
            RedirectIfUnauthorized(exception);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void BeginReject(OrderSummaryResponse order)
    {
        rejectingOrder = order;
        rejectForm.Reason = string.Empty;
    }

    private void CancelReject()
    {
        rejectingOrder = null;
        rejectForm.Reason = string.Empty;
    }

    private async Task RejectAsync()
    {
        if (rejectingOrder is null)
        {
            return;
        }

        isSubmitting = true;
        error = null;

        try
        {
            await ApiClient.RejectOrderAsync(rejectingOrder.Id, new RejectOrderRequest(rejectForm.Reason));
            CancelReject();
            await LoadAsync();
        }
        catch (ApiClientException exception)
        {
            error = exception;
            RedirectIfUnauthorized(exception);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private static bool CanConfirm(OrderSummaryResponse order) =>
        string.Equals(order.OrderStatus, "pending_confirmation", StringComparison.OrdinalIgnoreCase);

    private void RedirectIfUnauthorized(ApiClientException exception)
    {
        if ((int)exception.StatusCode == 401)
        {
            Navigation.NavigateTo("/login");
        }
    }

    private async void OnOrderChanged(object? sender, OrderRealtimeEvent orderEvent)
    {
        await InvokeAsync(LoadAsync);
    }

    public void Dispose()
    {
        RealtimeClient.OrderChanged -= OnOrderChanged;
    }

    private sealed class RejectForm
    {
        [Required]
        public string Reason { get; set; } = string.Empty;
    }
}
