@page "/staff"
@using System.ComponentModel.DataAnnotations
@inject IVelonixsConnectApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Staff Users</PageTitle>

<section class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 mb-4">
    <div>
        <p class="eyebrow">@restaurantName</p>
        <h1>Staff Users</h1>
    </div>
    <div class="d-flex flex-wrap gap-2 justify-content-sm-end ms-sm-auto">
        <a class="btn btn-outline-primary" href="/">Dashboard</a>
        <button class="btn btn-outline-secondary" type="button" @onclick="LoadAsync">Refresh</button>
    </div>
</section>

<ApiErrorAlert Error="error" Title="Staff unavailable" />
<LoadingPanel IsLoading="isLoading" Message="Loading staff" />

<div class="row g-4">
    <div class="col-12 col-xl-7">
        <section class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5 mb-3">Current users</h2>
                <div class="table-responsive stack-mobile">
                    <table class="table table-hover align-middle mb-0 responsive-stack">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in staff.OrderBy(x => x.DisplayName))
                            {
                                <tr>
                                    <td data-label="Name">@user.DisplayName</td>
                                    <td data-label="Email">@user.Email</td>
                                    <td data-label="Role"><span class="badge text-bg-light border">@user.Role</span></td>
                                    <td data-label="Status"><span class="badge @(user.IsActive ? "text-bg-success" : "text-bg-secondary")">@(user.IsActive ? "Active" : "Inactive")</span></td>
                                    <td data-label="" class="text-end">
                                        @if (user.Role != "BusinessOwner")
                                        {
                                            <button class="btn btn-sm @(user.IsActive ? "btn-outline-danger" : "btn-outline-success")" type="button" @onclick="() => ToggleStatusAsync(user)" disabled="@isSubmitting">
                                                @(user.IsActive ? "Disable" : "Enable")
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </div>

    <div class="col-12 col-xl-5">
        <section class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5 mb-3">Create staff login</h2>
                @if (!string.IsNullOrWhiteSpace(successMessage))
                {
                    <div class="success-alert">@successMessage</div>
                }
                <EditForm Model="form" OnValidSubmit="CreateAsync" class="row g-3">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <div class="col-12">
                        <label class="form-label">Name</label>
                        <InputText class="form-control" @bind-Value="form.DisplayName" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Email</label>
                        <InputText class="form-control" @bind-Value="form.Email" type="email" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Temporary Password</label>
                        <InputText class="form-control" @bind-Value="form.Password" type="password" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Role</label>
                        <InputSelect class="form-select" @bind-Value="form.Role">
                            <option value="BusinessManager">BusinessManager</option>
                            <option value="Cashier">Cashier</option>
                            <option value="Staff">Staff</option>
                        </InputSelect>
                    </div>
                    <div class="col-12">
                        <button class="btn btn-primary w-100" type="submit" disabled="@isSubmitting">
                            @(isSubmitting ? "Creating" : "Create staff account")
                        </button>
                    </div>
                </EditForm>
            </div>
        </section>
    </div>
</div>

@code {
    private IReadOnlyCollection<StaffUserResponse> staff = Array.Empty<StaffUserResponse>();
    private readonly StaffForm form = new();
    private string restaurantName = "Restaurant";
    private bool isLoading;
    private bool isSubmitting;
    private string? successMessage;
    private ApiClientException? error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        error = null;

        try
        {
            var dashboard = await ApiClient.GetRestaurantDashboardAsync();
            restaurantName = dashboard.Restaurant.Name;
            staff = await ApiClient.GetStaffAsync();
        }
        catch (ApiClientException exception)
        {
            error = exception;
            RedirectIfUnauthorized(exception);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CreateAsync()
    {
        isSubmitting = true;
        error = null;
        successMessage = null;

        try
        {
            var created = await ApiClient.CreateStaffAsync(
                restaurantId: null,
                new CreateStaffUserRequest(form.DisplayName, form.Email, form.Password, form.Role));
            successMessage = $"Created {created.Email}.";
            form.Reset();
            await LoadAsync();
        }
        catch (ApiClientException exception)
        {
            error = exception;
            RedirectIfUnauthorized(exception);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task ToggleStatusAsync(StaffUserResponse user)
    {
        isSubmitting = true;
        error = null;

        try
        {
            await ApiClient.UpdateStaffStatusAsync(
                user.Id,
                restaurantId: null,
                new UpdateStaffStatusRequest(!user.IsActive));
            await LoadAsync();
        }
        catch (ApiClientException exception)
        {
            error = exception;
            RedirectIfUnauthorized(exception);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void RedirectIfUnauthorized(ApiClientException exception)
    {
        if ((int)exception.StatusCode == 401)
        {
            Navigation.NavigateTo("/login");
        }
    }

    private sealed class StaffForm
    {
        [Required]
        public string DisplayName { get; set; } = string.Empty;

        [Required]
        [EmailAddress]
        public string Email { get; set; } = string.Empty;

        [Required]
        [MinLength(8)]
        public string Password { get; set; } = string.Empty;

        [Required]
        public string Role { get; set; } = "Staff";

        public void Reset()
        {
            DisplayName = string.Empty;
            Email = string.Empty;
            Password = string.Empty;
            Role = "Staff";
        }
    }
}
