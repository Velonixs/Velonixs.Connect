@page "/portal/dashboard"
@attribute [Authorize(Roles = AppRoles.PortalRoles)]
@implements IAsyncDisposable
@using Velonixs.Connect.Domain.Entities
@inject IRestaurantService RestaurantService
@inject IMenuService MenuService
@inject IOrderService OrderService

<PageTitle>Business Dashboard | Velonixs Connect</PageTitle>

@if (_loading)
{
    <section class="portal-blazor-message">
        <h1>Loading dashboard</h1>
        <p>Retrieving your current business activity.</p>
    </section>
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <section class="portal-blazor-message portal-blazor-message-error">
        <h1>Dashboard unavailable</h1>
        <p>@_error</p>
        <button class="btn btn-primary" @onclick="LoadAsync">Try again</button>
    </section>
}
else if (_restaurant is not null)
{
    <header class="portal-blazor-page-head">
        <div>
            <p class="portal-blazor-eyebrow">Today at a glance</p>
            <h1>@_restaurant.Name</h1>
            <p class="text-muted mb-0">Track orders and keep your WhatsApp menu ready for customers.</p>
        </div>
        <button class="btn btn-outline-primary" @onclick="LoadAsync">Refresh</button>
    </header>

    @if (_newCatalogOrderIds.Count > 0)
    {
        <section class="portal-blazor-catalog-order-alert" role="alert" aria-live="assertive">
            <div>
                <p class="portal-blazor-eyebrow">New WhatsApp catalog order</p>
                <strong>@_newCatalogOrderIds.Count new order@(_newCatalogOrderIds.Count == 1 ? string.Empty : "s") need@(_newCatalogOrderIds.Count == 1 ? "s" : string.Empty) confirmation.</strong>
                <span>Open the order queue to accept with a preparation time or reject with a reason.</span>
            </div>
            <div class="portal-blazor-catalog-order-actions">
                <a class="btn btn-primary btn-sm" href="/portal/orders">Review orders</a>
                <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="DismissCatalogOrderAlert">Dismiss</button>
            </div>
        </section>
    }
    else
    {
        <p class="portal-blazor-live-status">
            <span class="portal-blazor-live-indicator" aria-hidden="true"></span>
            WhatsApp catalog orders are checked every 20 seconds. Last checked @LastOrderRefreshLabel.
            @if (_liveRefreshFailed)
            {
                <span>Live updates are temporarily unavailable; use Refresh to try again.</span>
            }
        </p>
    }

    <section class="portal-blazor-metrics" aria-label="Business metrics">
        <article class="portal-blazor-metric portal-blazor-metric-urgent">
            <span>Needs confirmation</span>
            <strong>@_pendingCount</strong>
            <a href="/portal/orders">Review orders</a>
        </article>
        <article class="portal-blazor-metric">
            <span>Orders today</span>
            <strong>@_todayOrderCount</strong>
            <small>All channels</small>
        </article>
        <article class="portal-blazor-metric">
            <span>Today’s revenue</span>
            <strong>₹@_todayRevenue.ToString("N2")</strong>
            <small>Completed and active orders</small>
        </article>
        <article class="portal-blazor-metric">
            <span>Available products</span>
            <strong>@_availableItemCount</strong>
            <a href="/portal/menu">Manage menu</a>
        </article>
    </section>

    <section class="portal-blazor-surface">
        <div class="portal-blazor-surface-head">
            <div>
                <p class="portal-blazor-eyebrow">Live work queue</p>
                <h2>Recent orders</h2>
            </div>
            <a class="btn btn-outline-primary btn-sm" href="/portal/orders">All orders</a>
        </div>

        @if (_recentOrders.Count == 0)
        {
            <div class="portal-blazor-empty">No orders have been received for this business yet.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle portal-blazor-table vx-table">
                    <thead>
                        <tr>
                            <th>Order</th>
                            <th>Customer</th>
                            <th>Status</th>
                            <th>Received</th>
                            <th class="text-end">Total</th>
                        </tr>
                        <tr class="vx-table-filter-row"><th><input class="vx-table-filter-input" aria-label="Filter recent orders" placeholder="Search order" @bind="_recentOrderFilter" @bind:event="oninput" /></th><th><input class="vx-table-filter-input" aria-label="Filter recent customers" placeholder="Search customer" @bind="_recentCustomerFilter" @bind:event="oninput" /></th><th><select class="vx-table-filter-select" aria-label="Filter recent order status" @bind="_recentStatusFilter"><option value="">All statuses</option>@foreach (var status in _recentOrders.Select(x => x.OrderStatus).Distinct()) { <option value="@status">@FormatStatus(status)</option> }</select></th><th><select class="vx-table-filter-select" aria-label="Filter recent order date" @bind="_recentDateFilter"><option value="">All dates</option><option value="today">Today</option><option value="7">Last 7 days</option></select></th><th></th></tr>
                    </thead>
                    <tbody>
                    @foreach (var order in FilteredRecentOrders)
                    {
                        <tr>
                            <td><a href="/portal/orders">@order.OrderNumber</a></td>
                            <td>
                                <strong>@order.CustomerName</strong>
                                <small>@order.CustomerPhone</small>
                                @if (IsWhatsAppCatalogOrder(order))
                                {
                                    <span class="portal-blazor-order-source">WhatsApp catalog</span>
                                }
                            </td>
                            <td><span class="portal-blazor-status">@FormatStatus(order.OrderStatus)</span></td>
                            <td>@order.CreatedAt.LocalDateTime.ToString("dd MMM, HH:mm")</td>
                            <td class="text-end">₹@order.TotalAmount.ToString("N2")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@code {
    private static readonly TimeSpan OrderRefreshInterval = TimeSpan.FromSeconds(20);

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private readonly CancellationTokenSource _orderRefreshCancellation = new();
    private readonly SemaphoreSlim _orderRefreshGate = new(1, 1);
    private readonly HashSet<Guid> _seenPendingCatalogOrderIds = [];
    private readonly HashSet<Guid> _newCatalogOrderIds = [];
    private RestaurantResponse? _restaurant;
    private IReadOnlyCollection<OrderSummaryResponse> _recentOrders = Array.Empty<OrderSummaryResponse>();
    private Guid? _businessId;
    private Task? _orderRefreshLoop;
    private bool _loading = true;
    private bool _initialOrdersLoaded;
    private bool _liveRefreshFailed;
    private string? _error;
    private int _pendingCount;
    private int _todayOrderCount;
    private int _availableItemCount;
    private decimal _todayRevenue;
    private DateTimeOffset? _lastOrderRefreshAt;
    private string _recentOrderFilter = string.Empty, _recentCustomerFilter = string.Empty, _recentStatusFilter = string.Empty, _recentDateFilter = string.Empty;
    private IReadOnlyCollection<OrderSummaryResponse> FilteredRecentOrders => _recentOrders.Where(order =>
        (string.IsNullOrWhiteSpace(_recentOrderFilter) || order.OrderNumber.Contains(_recentOrderFilter, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_recentCustomerFilter) || order.CustomerName.Contains(_recentCustomerFilter, StringComparison.OrdinalIgnoreCase) || order.CustomerPhone.Contains(_recentCustomerFilter, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_recentStatusFilter) || order.OrderStatus == _recentStatusFilter) &&
        (_recentDateFilter == "" || (_recentDateFilter == "today" ? order.CreatedAt.LocalDateTime.Date == DateTime.Today : order.CreatedAt >= DateTimeOffset.Now.AddDays(-7)))).ToArray();

    private string LastOrderRefreshLabel => _lastOrderRefreshAt is { } refreshedAt
        ? refreshedAt.LocalDateTime.ToString("HH:mm:ss")
        : "starting";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _orderRefreshLoop = RefreshOrderQueueLoopAsync(_orderRefreshCancellation.Token);
        }

        return Task.CompletedTask;
    }

    private async Task LoadAsync()
    {
        await _orderRefreshGate.WaitAsync();

        try
        {
            _loading = true;
            _error = null;
            var businessId = await GetBusinessIdAsync();
            if (businessId is null)
            {
                _businessId = null;
                _initialOrdersLoaded = false;
                _error = "Your account is missing its business assignment. Please contact your administrator.";
                return;
            }

            _businessId = businessId;
            _restaurant = await RestaurantService.GetRestaurantAsync(businessId.Value);
            if (_restaurant is null)
            {
                _businessId = null;
                _initialOrdersLoaded = false;
                _error = "The business linked to your account could not be found.";
                return;
            }

            // Application services share the circuit's scoped data session, so keep these calls
            // sequential rather than issuing parallel database operations from one Blazor circuit.
            var orders = await OrderService.GetRestaurantOrdersAsync(businessId.Value);
            var menu = await MenuService.GetMenuAsync(businessId.Value);

            ApplyOrderQueue(orders, announceNewCatalogOrders: _initialOrdersLoaded);
            _initialOrdersLoaded = true;
            _availableItemCount = menu?.Items.Count(item => item.IsActive && item.IsAvailable) ?? 0;
            _lastOrderRefreshAt = DateTimeOffset.UtcNow;
            _liveRefreshFailed = false;
        }
        catch (Exception)
        {
            _error = "We could not load the business dashboard. Please try again.";
        }
        finally
        {
            _loading = false;
            _orderRefreshGate.Release();
        }
    }

    private async Task RefreshOrderQueueLoopAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(OrderRefreshInterval);

        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    await RefreshOrderQueueAsync(cancellationToken);
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // The component was removed from its interactive circuit.
        }
        catch (ObjectDisposedException)
        {
            // The interactive circuit ended while the refresh was being scheduled.
        }
    }

    private async Task RefreshOrderQueueAsync(CancellationToken cancellationToken)
    {
        if (!_initialOrdersLoaded || _businessId is null)
        {
            return;
        }

        try
        {
            await _orderRefreshGate.WaitAsync(cancellationToken);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return;
        }

        try
        {
            var orders = await OrderService.GetRestaurantOrdersAsync(_businessId.Value, cancellationToken);
            ApplyOrderQueue(orders, announceNewCatalogOrders: true);
            _lastOrderRefreshAt = DateTimeOffset.UtcNow;
            _liveRefreshFailed = false;
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // The component is shutting down; do not surface a stale error.
        }
        catch (Exception)
        {
            // Keep the most recently rendered queue available and make the fallback explicit.
            _liveRefreshFailed = true;
        }
        finally
        {
            _orderRefreshGate.Release();
        }
    }

    private void ApplyOrderQueue(
        IReadOnlyCollection<OrderSummaryResponse> orders,
        bool announceNewCatalogOrders)
    {
        var today = DateTime.UtcNow.Date;
        var pendingCatalogOrderIds = orders
            .Where(IsPendingWhatsAppCatalogOrder)
            .Select(order => order.Id)
            .ToHashSet();

        if (announceNewCatalogOrders)
        {
            foreach (var orderId in pendingCatalogOrderIds.Where(orderId => !_seenPendingCatalogOrderIds.Contains(orderId)))
            {
                _newCatalogOrderIds.Add(orderId);
            }
        }

        _seenPendingCatalogOrderIds.UnionWith(pendingCatalogOrderIds);
        _newCatalogOrderIds.IntersectWith(pendingCatalogOrderIds);

        _recentOrders = orders.Take(8).ToArray();
        _pendingCount = orders.Count(order =>
            string.Equals(order.OrderStatus, OrderStatuses.PendingConfirmation, StringComparison.OrdinalIgnoreCase));
        _todayOrderCount = orders.Count(order => order.CreatedAt.UtcDateTime.Date == today);
        _todayRevenue = orders
            .Where(order => order.CreatedAt.UtcDateTime.Date == today)
            .Sum(order => order.TotalAmount);
    }

    private void DismissCatalogOrderAlert() => _newCatalogOrderIds.Clear();

    private static bool IsPendingWhatsAppCatalogOrder(OrderSummaryResponse order) =>
        IsWhatsAppCatalogOrder(order) &&
        string.Equals(order.OrderStatus, OrderStatuses.PendingConfirmation, StringComparison.OrdinalIgnoreCase);

    private static bool IsWhatsAppCatalogOrder(OrderSummaryResponse order) =>
        string.Equals(order.Source, OrderSources.WhatsAppCatalog, StringComparison.OrdinalIgnoreCase);

    private async Task<Guid?> GetBusinessIdAsync()
    {
        var authenticationState = AuthenticationStateTask is null
            ? null
            : await AuthenticationStateTask;
        var value = authenticationState?.User.FindFirst(AppClaimTypes.BusinessId)?.Value;

        return Guid.TryParse(value, out var businessId) ? businessId : null;
    }

    private static string FormatStatus(string status) =>
        string.IsNullOrWhiteSpace(status)
            ? "Unknown"
            : System.Text.RegularExpressions.Regex.Replace(status, "(?<!^)([A-Z])", " $1");

    public async ValueTask DisposeAsync()
    {
        _orderRefreshCancellation.Cancel();

        if (_orderRefreshLoop is not null)
        {
            try
            {
                await _orderRefreshLoop;
            }
            catch (OperationCanceledException)
            {
                // Expected when the component is disposed.
            }
        }

        _orderRefreshCancellation.Dispose();
    }
}
