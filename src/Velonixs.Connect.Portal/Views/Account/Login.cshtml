@model LoginViewModel

@{
    ViewData["Title"] = "Business Portal Sign In";
}

<section class="auth-shell">
    <div class="auth-context-panel">
        <div>
            <span class="auth-context-kicker">Business portal</span>
            <h1>Sign in to Velonixs Connect</h1>
        </div>
    </div>
    <div class="auth-form-wrap">
        <form class="auth-panel" action="/" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="ReturnUrl" type="hidden" />
            <div class="auth-panel-heading">
                <p class="eyebrow">Velonixs Connect</p>
                <h2>Sign in</h2>
            </div>
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <label class="auth-field">
                <span>Email address</span>
                <input asp-for="Email" autocomplete="username" placeholder="you@business.com" />
                <span asp-validation-for="Email" class="field-error"></span>
            </label>
            <label class="auth-field">
                <span>Password</span>
                <input asp-for="Password" autocomplete="current-password" placeholder="Enter your password" />
                <span asp-validation-for="Password" class="field-error"></span>
            </label>
            <button class="btn btn-primary w-100" type="submit">Sign in</button>
        </form>
    </div>
</section>
