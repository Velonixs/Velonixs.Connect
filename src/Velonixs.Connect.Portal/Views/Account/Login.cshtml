@model LoginViewModel

@{
    ViewData["Title"] = "Portal Sign In";
}

<section class="auth-shell">
    <form class="status-panel auth-panel" asp-action="Login" asp-controller="Account" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="ReturnUrl" type="hidden" />

        <div>
            <p class="eyebrow">Staff access</p>
            <h1>Sign in to the business portal</h1>
        </div>

        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <label>
            <span>Email</span>
            <input asp-for="Email" autocomplete="username" />
            <span asp-validation-for="Email" class="field-error"></span>
        </label>

        <label>
            <span>Password</span>
            <input asp-for="Password" autocomplete="current-password" />
            <span asp-validation-for="Password" class="field-error"></span>
        </label>

        <button class="button" type="submit">Sign in</button>
    </form>
</section>
