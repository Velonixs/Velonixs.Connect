@model PortalCustomersViewModel
@{
    ViewData["Title"] = "Customers";
    var canEditCustomers = User.IsInRole(Velonixs.Connect.Shared.Security.AppRoles.BusinessOwner) ||
        User.IsInRole(Velonixs.Connect.Shared.Security.AppRoles.BusinessManager);
}

<section class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-4">
    <div>
        <p class="eyebrow">@Model.Restaurant.Name</p>
        <h1>Customers</h1>
        <p class="text-secondary mb-0">Review customer records and update saved delivery details when needed.</p>
    </div>
    <a class="btn btn-outline-primary" asp-action="Index">Back to dashboard</a>
</section>

<section class="card shadow-sm">
    <div class="card-body">
        <div class="section-heading">
            <h2>Recent Customers</h2>
        </div>
        <div class="table-responsive stack-mobile">
            <table class="table table-hover align-middle mb-0 responsive-stack">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>Last Address</th>
                        <th>Last Active</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var customer in Model.Customers)
                {
                    <tr>
                        <td colspan="5" class="p-0">
                            @if (canEditCustomers)
                            {
                                <form class="customer-row" asp-action="UpdateCustomer" asp-route-id="@customer.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <input class="form-control" name="Name" value="@customer.Name" placeholder="Customer name" aria-label="Customer name" />
                                    <span class="fw-semibold">@customer.PhoneNumber</span>
                                    <input class="form-control" name="LastAddress" value="@customer.LastAddress" placeholder="Last address" aria-label="Last address" />
                                    <span>@customer.LastInteractionAt.ToLocalTime().ToString("dd MMM, hh:mm tt")</span>
                                    <div class="text-end">
                                        <button class="btn btn-sm btn-primary" type="submit">Save</button>
                                    </div>
                                </form>
                            }
                            else
                            {
                                <div class="customer-row readonly">
                                    <span>@(customer.Name ?? "WhatsApp Customer")</span>
                                    <span>@customer.PhoneNumber</span>
                                    <span>@customer.LastAddress</span>
                                    <span>@customer.LastInteractionAt.ToLocalTime().ToString("dd MMM, hh:mm tt")</span>
                                    <span></span>
                                </div>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Customers.Any())
                {
                    <tr><td colspan="5" class="text-secondary">No customers yet.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</section>
