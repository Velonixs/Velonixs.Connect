@model PortalDashboardViewModel
@{
    ViewData["Title"] = Model.Restaurant.Name;
}

<section class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-4">
    <div>
        <p class="eyebrow">Live Business</p>
        <h1>@Model.Restaurant.Name</h1>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="badge text-bg-light border">@Model.CurrentRole</span>
        <span class="badge @(Model.Restaurant.IsActive ? "text-bg-success" : "text-bg-secondary")">@(Model.Restaurant.IsActive ? "Active" : "Inactive")</span>
    </div>
</section>

<section class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3"><div class="metric urgent h-100">
        <span>Pending Orders</span>
        <strong>@Model.PendingOrderCount</strong>
        <small>Awaiting restaurant confirmation</small>
    </div></div>
    <div class="col-12 col-sm-6 col-xl-3"><div class="metric h-100">
        <span>Today Orders</span>
        <strong>@Model.TodayOrderCount</strong>
        <small>Current business day</small>
    </div></div>
    <div class="col-12 col-sm-6 col-xl-3"><div class="metric h-100">
        <span>Today Revenue</span>
        <strong>Rs @Model.TodayRevenue.ToString("0.##")</strong>
        <small>WhatsApp orders</small>
    </div></div>
    <div class="col-12 col-sm-6 col-xl-3"><div class="metric h-100">
        <span>Available Products</span>
        <strong>@Model.AvailableItemCount</strong>
        <small>Visible to customers</small>
    </div></div>
</section>

<section class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <a class="card module-tile h-100 text-decoration-none" asp-action="Menu">
            <div class="card-body">
                <span class="eyebrow">Menu</span>
                <h2 class="h4">Price & Stock</h2>
                <p class="text-secondary mb-0">Map menu items, update prices, stock, and active status.</p>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-4">
        <a class="card module-tile h-100 text-decoration-none" asp-action="Customers">
            <div class="card-body">
                <span class="eyebrow">Customers</span>
                <h2 class="h4">Customer Records</h2>
                <p class="text-secondary mb-0">Review and edit customer names and saved addresses.</p>
            </div>
        </a>
    </div>
    @if (User.IsInRole(Velonixs.Connect.Shared.Security.AppRoles.BusinessOwner))
    {
        <div class="col-12 col-md-4">
            <a class="card module-tile h-100 text-decoration-none" asp-action="Staff">
                <div class="card-body">
                    <span class="eyebrow">Team</span>
                    <h2 class="h4">Staff Users</h2>
                    <p class="text-secondary mb-0">Manage portal users and access for this business.</p>
                </div>
            </a>
        </div>
    }
</section>

@if (Model.PendingOrderCount > 0)
{
    <section class="alert alert-warning border-warning shadow-sm new-order-alert" role="alert">
        <strong>New order alert:</strong> @Model.PendingOrderCount order@(Model.PendingOrderCount == 1 ? "" : "s") waiting for confirmation.
        Open the order to confirm or reject it.
    </section>
}

<section class="card shadow-sm">
    <div class="card-body">
        <div class="section-heading">
            <h2>Orders</h2>
        </div>
        <div class="table-responsive stack-mobile">
            <table class="table table-hover align-middle mb-0 responsive-stack">
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Customer</th>
                        <th>Status</th>
                        <th>Total</th>
                        <th>Time</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var order in Model.Orders)
                {
                    <tr class="@(order.OrderStatus == Velonixs.Connect.Domain.Entities.OrderStatuses.PendingConfirmation ? "table-warning pending-order-row" : "")">
                        <td data-label="Order"><strong>@order.OrderNumber</strong><small>@order.Address</small></td>
                        <td data-label="Customer">@order.CustomerName<small>@order.CustomerPhone</small></td>
                        <td data-label="Status"><span class="pill">@order.OrderStatus</span></td>
                        <td data-label="Total">Rs @order.TotalAmount.ToString("0.##")</td>
                        <td data-label="Time">@order.CreatedAt.ToLocalTime().ToString("dd MMM, hh:mm tt")</td>
                        <td data-label="" class="text-end"><a class="btn btn-sm btn-primary" asp-action="Order" asp-route-id="@order.Id">Open</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</section>

@if (Model.PendingOrderCount > 0)
{
    <script>
        (() => {
            if (sessionStorage.getItem("velonixs.pendingOrderAlert") === "@Model.PendingOrderCount") {
                return;
            }

            sessionStorage.setItem("velonixs.pendingOrderAlert", "@Model.PendingOrderCount");
            const AudioContextCtor = window.AudioContext || window.webkitAudioContext;
            if (!AudioContextCtor) {
                return;
            }

            const context = new AudioContextCtor();
            const oscillator = context.createOscillator();
            const gain = context.createGain();
            oscillator.type = "sine";
            oscillator.frequency.value = 880;
            gain.gain.setValueAtTime(0.001, context.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.15, context.currentTime + 0.02);
            gain.gain.exponentialRampToValueAtTime(0.001, context.currentTime + 0.35);
            oscillator.connect(gain);
            gain.connect(context.destination);
            oscillator.start();
            oscillator.stop(context.currentTime + 0.38);
        })();
    </script>
}

<script>
    window.setTimeout(() => {
        if (!document.hidden) {
            window.location.reload();
        }
    }, 15000);
</script>
