@model PortalMenuViewModel
@{
    ViewData["Title"] = "Menu, Price & Stock";
    var masterCategories = Model.MasterCatalog?.Categories ?? Array.Empty<MasterMenuCategoryResponse>();
    var masterItems = Model.MasterCatalog?.Items ?? Array.Empty<MasterMenuItemResponse>();
    var categories = Model.Menu?.Categories ?? Array.Empty<MenuCategoryResponse>();
    var items = Model.Menu?.Items ?? Array.Empty<MenuItemResponse>();
}

<section class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-4">
    <div>
        <p class="eyebrow">@Model.Restaurant.Name</p>
        <h1>Menu, Price & Stock</h1>
        <p class="text-secondary mb-0">Manage this restaurant's menu only. WhatsApp customers see active and available items.</p>
    </div>
    <a class="btn btn-outline-primary" asp-action="Index">Back to dashboard</a>
</section>

@if (Model.CanManageMenu)
{
    <section class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="section-heading">
                <div>
                    <h2>GST Settings</h2>
                    <p class="text-secondary mb-0">These rates are added to the order total for this restaurant.</p>
                </div>
            </div>
            <form class="row g-3 align-items-end" asp-action="UpdateTaxSetting" method="post">
                @Html.AntiForgeryToken()
                <div class="col-12 col-md-3">
                    <label class="form-label">CGST %</label>
                    <input class="form-control" asp-for="TaxSetting.CgstPercent" name="CgstPercent" type="number" min="0" max="100" step="0.01" />
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label">SGST %</label>
                    <input class="form-control" asp-for="TaxSetting.SgstPercent" name="SgstPercent" type="number" min="0" max="100" step="0.01" />
                </div>
                <div class="col-12 col-md-auto">
                    <button class="btn btn-primary" type="submit">Save GST</button>
                </div>
            </form>
        </div>
    </section>

    <section class="row g-3 mb-4">
        <div class="col-12 col-xl-5">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h4">Map category</h2>
                    @if (masterCategories.Any(x => x.IsActive))
                    {
                        <form class="row g-3 align-items-end" asp-action="CreateCategory" method="post">
                            @Html.AntiForgeryToken()
                            <div class="col-12 col-lg-7">
                                <label class="form-label">Master category</label>
                                <select class="form-select" asp-for="NewCategory.MasterCategoryId" name="MasterCategoryId" required>
                                    @foreach (var category in masterCategories.Where(x => x.IsActive))
                                    {
                                        <option value="@category.Id">@category.Name</option>
                                    }
                                </select>
                                <input asp-for="NewCategory.Name" name="Name" type="hidden" value="From master" />
                            </div>
                            <div class="col-6 col-lg-2">
                                <label class="form-label">Order</label>
                                <input class="form-control" asp-for="NewCategory.DisplayOrder" name="DisplayOrder" type="number" />
                            </div>
                            <div class="col-6 col-lg-3">
                                <div class="form-check mb-lg-2">
                                    <input class="form-check-input" asp-for="NewCategory.IsActive" name="IsActive" />
                                    <label class="form-check-label">Active</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <button class="btn btn-primary w-100" type="submit">Map category</button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <p class="text-secondary mb-0">Ask platform admin to add master categories first.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-7">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h4">Map menu item</h2>
                    @if (categories.Any(x => x.IsActive) && masterItems.Any(x => x.IsActive))
                    {
                        <form class="row g-3 align-items-end" asp-action="CreateMenuItem" method="post">
                            @Html.AntiForgeryToken()
                            <div class="col-12 col-lg-4">
                                <label class="form-label">Master item</label>
                                <select class="form-select" asp-for="NewItem.MasterMenuItemId" name="MasterMenuItemId" required>
                                    @foreach (var item in masterItems.Where(x => x.IsActive))
                                    {
                                        <option value="@item.Id">@item.MasterCategoryName - @item.Name</option>
                                    }
                                </select>
                                <input asp-for="NewItem.Name" name="Name" type="hidden" value="From master" />
                            </div>
                            <div class="col-12 col-lg-3">
                                <label class="form-label">Category</label>
                                <select class="form-select" asp-for="NewItem.CategoryId" name="CategoryId" required>
                                    @foreach (var category in categories.Where(x => x.IsActive))
                                    {
                                        <option value="@category.Id">@category.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-6 col-lg-2">
                                <label class="form-label">Code</label>
                                <input class="form-control" asp-for="NewItem.ItemCode" name="ItemCode" type="number" min="1" required />
                            </div>
                            <div class="col-6 col-lg-3">
                                <label class="form-label">Price</label>
                                <input class="form-control" asp-for="NewItem.Price" name="Price" type="number" step="0.01" min="0" required />
                            </div>
                            <div class="col-12 col-lg-4">
                                <label class="form-label">Product Retailer ID</label>
                                <input class="form-control" asp-for="NewItem.ProductRetailerId" name="ProductRetailerId" placeholder="Meta catalog SKU" />
                            </div>
                            <div class="col-12 d-flex flex-wrap gap-3">
                                <div class="form-check">
                                    <input class="form-check-input" asp-for="NewItem.IsAvailable" name="IsAvailable" />
                                    <label class="form-check-label">In stock</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" asp-for="NewItem.IsActive" name="IsActive" />
                                    <label class="form-check-label">Active</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <button class="btn btn-primary w-100" type="submit">Map item</button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <p class="text-secondary mb-0">Map an active category and ask platform admin to add master items first.</p>
                    }
                </div>
            </div>
        </div>
    </section>
}

<section class="card shadow-sm">
    <div class="card-body">
        <div class="section-heading">
            <h2>Restaurant Menu Items</h2>
        </div>

        <div class="portal-menu-list">
        @foreach (var item in items.OrderBy(x => x.ItemCode))
        {
            if (Model.CanManageMenu)
            {
                <form class="portal-menu-row" asp-action="UpdateMenuItem" asp-route-id="@item.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input name="ItemCode" value="@item.ItemCode" type="number" min="1" aria-label="Item code" required />
                    <select name="MasterMenuItemId" aria-label="Master menu item" required>
                        @foreach (var masterItem in masterItems.Where(x => x.IsActive || x.Id == item.MasterMenuItemId))
                        {
                            if (masterItem.Id == item.MasterMenuItemId)
                            {
                                <option value="@masterItem.Id" selected>@masterItem.Name</option>
                            }
                            else
                            {
                                <option value="@masterItem.Id">@masterItem.Name</option>
                            }
                        }
                    </select>
                    <select name="CategoryId" aria-label="Category" required>
                        @foreach (var category in categories)
                        {
                            if (category.Id == item.CategoryId)
                            {
                                <option value="@category.Id" selected>@category.Name</option>
                            }
                            else
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        }
                    </select>
                    <input name="Price" value="@item.Price.ToString("0.##")" type="number" step="0.01" min="0" aria-label="Price" required />
                    <input name="ProductRetailerId" value="@item.ProductRetailerId" aria-label="Product retailer ID" placeholder="Catalog SKU" />
                    <input name="Name" value="@item.Name" type="hidden" />
                    <label class="form-check mb-0">
                        <input class="form-check-input" name="IsAvailable" type="checkbox" value="true" checked="@item.IsAvailable" />
                        <input name="IsAvailable" type="hidden" value="false" />
                        <span class="form-check-label">In stock</span>
                    </label>
                    <label class="form-check mb-0">
                        <input class="form-check-input" name="IsActive" type="checkbox" value="true" checked="@item.IsActive" />
                        <input name="IsActive" type="hidden" value="false" />
                        <span class="form-check-label">Active</span>
                    </label>
                    <button class="btn btn-sm btn-primary" type="submit">Save</button>
                    <button class="btn btn-sm btn-outline-secondary" type="submit" formaction="@Url.Action("DeactivateMenuItem", "Portal", new { id = item.Id })">Deactivate</button>
                    <button class="btn btn-sm btn-outline-danger" type="submit" formaction="@Url.Action("DeleteMenuItem", "Portal", new { id = item.Id })">Delete</button>
                </form>
            }
            else
            {
                <article class="portal-menu-row readonly">
                    <strong>@item.ItemCode. @item.Name</strong>
                    <span>@item.CategoryName</span>
                    <span>Rs @item.Price.ToString("0.##")</span>
                    <span>@(string.IsNullOrWhiteSpace(item.ProductRetailerId) ? "No catalog SKU" : item.ProductRetailerId)</span>
                    <span class="badge @(item.IsAvailable ? "text-bg-success" : "text-bg-secondary")">@(item.IsAvailable ? "In stock" : "Out of stock")</span>
                    <span class="badge @(item.IsActive ? "text-bg-success" : "text-bg-secondary")">@(item.IsActive ? "Active" : "Inactive")</span>
                </article>
            }
        }

        @if (!items.Any())
        {
            <div class="alert alert-info mb-0">
                No menu items yet. Add a category and item to start accepting WhatsApp orders.
            </div>
        }
        </div>

        @if (Model.CanManageMenu)
        {
            <div class="alert alert-light border mt-3 mb-0">
                Stock is currently managed as <strong>In stock / Out of stock</strong>. Out-of-stock or inactive items are hidden from the WhatsApp ordering menu.
            </div>
        }
    </div>
</section>
