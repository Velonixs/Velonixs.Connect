<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Velonixs Connect</title>
    <link rel="icon" type="image/jpeg" href="~/images/velonixs-logo.jpg" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/portal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/vx-shell.css" asp-append-version="true" />
</head>
<body>
    <header class="vx-auth-header">
        <a class="vx-brand vx-brand-logo-link" href="/portal/dashboard" aria-label="Velonixs Connect Business Portal home">
            <img class="vx-brand-logo" src="/images/velonixs-logo.jpg" alt="Velonixs" />
        </a>
        <span class="vx-auth-company"><strong>Velonixs Systems Private Limited</strong><small>Velonixs Connect &middot; Business Portal</small></span>
        <span class="vx-auth-header-spacer" aria-hidden="true"></span>
    </header>
    <main class="vx-auth-page">
        @if (TempData["Success"] is string success) { <div class="vx-alert vx-alert-success" role="alert">@success</div> }
        @if (TempData["Warning"] is string warning) { <div class="vx-alert vx-alert-warning" role="alert">@warning</div> }
        @if (TempData["Error"] is string error) { <div class="vx-alert vx-alert-danger" role="alert">@error</div> }
        @RenderBody()
    </main>
    <footer class="vx-app-footer">&copy; 2026 Velonixs Systems Private Limited. All rights reserved.</footer>
</body>
</html>
